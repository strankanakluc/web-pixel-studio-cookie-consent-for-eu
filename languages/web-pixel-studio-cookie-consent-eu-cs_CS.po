msgid "Automatické spustenie"
msgstr "Automatické spuštění"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "Banner se zobrazí automaticky při načtení stránky."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Doporučujeme zapnout. Vypnuto = zobrazit ručně přes <code>CookieConsentWPS.showBanner()</code>"

msgid "Vynútený súhlas"
msgstr "Vynucený souhlas"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "Uživatel nemůže prohlížet web bez udělení souhlasu."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ GDPR neukládá povinnost vynucovat souhlas. Doporučujeme VYPNOUT – uživatel má právo odmítnout."

msgid "Automatické vymazanie cookies"
msgstr "Automatické mazání cookies"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "Při odvolání souhlasu se automaticky smažou cookies dané kategorie."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Funguje pouze pro cookies deklarované v záložce Cookies. Doporučujeme zapnout."

msgid "Správa skriptov na stránke"
msgstr "Správa skriptů na stránce"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Blokuje skripty třetích stran, dokud uživatel neudělí souhlas."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Definujte pravidla v záložce \"Blokování skriptů\". Plugin změní typ skriptu na text/plain."

msgid "Skryť pre robotov"
msgstr "Skrýt pro roboty"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "Banner se nezobrazí vyhledávačům a robotům."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Doporučujeme zapnout. Zlepšuje SEO skóre webu."

msgid "Opätovný súhlas"
msgstr "Opětovný souhlas"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Banner se zobrazí znovu, když se změní seznam cookies."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Doporučujeme zapnout – GDPR vyžaduje nový souhlas po změně účelu zpracování."

msgid "Zaznamenávať súhlasy"
msgstr "Zaznamenávat souhlasy"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Každý souhlas se uloží do databáze (ID, IP, URL, čas)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Doporučujeme zapnout – záznamy slouží jako důkaz souhlasu pro GDPR audit."

msgid "Jazyk podľa návštevníka"
msgstr "Jazyk podle návštěvníka"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "Frontendová lišta cookies se pokusí načíst jazyk návštěvníka a zobrazit odpovídající dostupný překlad."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Pokud jazyk návštěvníka není dostupný, plugin použije English (GB). Pokud je volba vypnutá, frontend používá aktuálně uložené texty banneru."

msgid "Skryť prázdne kategórie"
msgstr "Skrýt prázdné kategorie"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "V modálním okně preferencí se skryjí kategorie bez deklarovaných cookies."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Zapněte, když máte vyplněné všechny kategorie v záložce Cookies."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Zpoždění zobrazení (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "Čas v milisekundách před zobrazením banneru."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 Hodnota 0 = okamžitě. Doporučujeme 0–500 ms. Vyšší hodnoty mohou být problém při GDPR auditech."

msgid "Platnosť súhlasu (dni)"
msgstr "Platnost souhlasu (dny)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Po kolika dnech vyprší souhlas a banner se zobrazí znovu."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 GDPR doporučuje max. 13 měsíců (390 dní). Výchozích 182 dní (6 měsíců) je bezpečná hodnota."

msgid "Cesta cookie"
msgstr "Cesta cookie"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Cesta, na které bude cookie platná."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Nechte \"/\" – cookie bude platná na celém webu."

msgid "Doména cookie"
msgstr "Doména cookie"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Nechte prázdné pro automatickou detekci."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Vyplňte \".mojeweb.sk\" (s tečkou), pokud chcete sdílet souhlas mezi subdoménami."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Co je Consent Mode?"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " Google Consent Mode umožňuje Googlu modelovat chybějící data, když uživatelé odmítnou analytické/reklamní cookies. Vaše kampaně budou měřitelné i bez plného souhlasu."

msgid "Verzia Consent Mode"
msgstr "Verze Consent Mode"

msgid "Vypnuté"
msgstr "Vypnuto"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "Consent Mode se nepoužívá. Vhodné pokud nepoužíváte Google Analytics ani Ads."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "Standard od března 2024. Vyžadováno pro Google Ads a GA4 v EU. Posílá signály ad_user_data a ad_personalization. Nutné pro remarketing a konverze."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "Rozšíření v2 o signál developer ID. Zahrnuje všechny funkce v2 + nastavení developer_id pro přesnější modelování konverzí. Vhodné pro pokročilé funkce Google Marketing Platform."

msgid "Odporúčané"
msgstr "Doporučené"

msgid "Nové"
msgstr "Nové"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 Pro většinu webů stačí v2. v3 použijte, pokud využíváte pokročilé funkce Google Marketing Platform. Obě verze vyžadují GTM nebo ruční načtení gtag.js."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Volitelné: Plugin načte GTM automaticky."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Vyplňte jen pokud GTM nenačítáte jiným způsobem. Pokud máte GTM v šabloně nebo jiném pluginu, nechte prázdné."

msgid "Typ bannera"
msgstr "Typ banneru"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – kompaktní popup v rohu. Bar – horizontální pruh přes celou šířku. Cloud – zaoblený popup s větším stínem."

msgid "Poloha bannera"
msgstr "Poloha banneru"

msgid "Dole vľavo"
msgstr "Dole vlevo"

msgid "Dole vpravo"
msgstr "Dole vpravo"

msgid "Dole v strede"
msgstr "Dole uprostřed"

msgid "Hore vľavo"
msgstr "Nahoře vlevo"

msgid "Hore vpravo"
msgstr "Nahoře vpravo"

msgid "Hore v strede"
msgstr "Nahoře uprostřed"

msgid "Stred obrazovky"
msgstr "Střed obrazovky"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Zobrazit plovoucí ikonu"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "Po udělení souhlasu se zobrazí ikona pro opětovnou správu preferencí."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Doporučujeme zapnout – GDPR vyžaduje, aby uživatel mohl kdykoli odvolat souhlas. Po kliknutí na ikonu se zobrazí panel s ID souhlasu a tlačítky."

msgid "Poloha ikony"
msgstr "Poloha ikony"

msgid "Vertikálny margin ikony (px)"
msgstr "Vertikální okraj ikony (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "Posune ikonu výše nebo níže od základní polohy podle vybraného rohu."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 Při dolní poloze vyšší hodnota zvedne ikonu výš. Při horní poloze vyšší hodnota ji posune níž."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Vertikální okraj ikony na mobilu (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Platí pouze pro mobilní zařízení (šířka do 520 px)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Použijte, pokud chcete mít na mobilu jinou výšku ikony než na desktopu."

msgid "Typ ikony"
msgstr "Typ ikony"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Vlastní ikona (obrázek)"

msgid "Vlastná ikona"
msgstr "Vlastní ikona"

msgid "Žiadny obrázok"
msgstr "Žádný obrázek"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Vybrat / nahrát obrázek"

msgid "Odstrániť"
msgstr "Odstranit"

msgid "Pozadie floating ikony"
msgstr "Pozadí plovoucí ikony"

msgid "Farba kruhu floating ikony."
msgstr "Barva kruhu plovoucí ikony."

msgid "Pozadie floating ikony (hover)"
msgstr "Pozadí plovoucí ikony (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "Barva kruhu plovoucí ikony při přejetí myší."

msgid "Farba obsahu floating ikony"
msgstr "Barva obsahu plovoucí ikony"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "Barva SVG ikony nebo obsahu v plovoucí ikoně."

msgid "Pozadie popupu floating ikony"
msgstr "Pozadí popupu plovoucí ikony"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "Barva pozadí popupu po kliknutí na plovoucí ikonu."

msgid "Farba textu popupu floating ikony"
msgstr "Barva textu popupu plovoucí ikony"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "Barva textu a obsahu popupu po kliknutí na plovoucí ikonu."

msgid "Zobraziť logo v banneri"
msgstr "Zobrazit logo v banneru"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "Vaše logo se zobrazí v pravém horním rohu lišty cookies."

msgid "Logo bannera"
msgstr "Logo banneru"

msgid "Šírka loga (px)"
msgstr "Šířka loga (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Šířka loga v pixelech (20–100 px). Výška se přizpůsobí automaticky."

msgid "Font"
msgstr "Font"

msgid "CSS font-family hodnota"
msgstr "CSS font-family hodnota"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "Pole nabízí pouze detekované fonty z šablony, theme.json, Elementoru a frontend CSS."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 V seznamu se zobrazuje pouze název písma. Po výběru se uloží kompletní hodnota font-family detekovaná na stránce. Volba \"Použít font šablony\" odpovídá hodnotě inherit."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Zaoblení tlačítek (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = hranaté, 8 = mírně zaoblené, 24+ = tvar \"pill\"."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Zaoblení banneru / modalu (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 Zaoblení rohů banneru i modalu. Výchozí: 12 px."

msgid "Farby bannera"
msgstr "Barvy banneru"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Nastavte barvy pro pozadí a text lišty cookies (banneru)."

msgid "Pozadie bannera"
msgstr "Pozadí banneru"

msgid "Farba pozadia cookie lišty."
msgstr "Barva pozadí lišty cookies."

msgid "Farba nadpisu bannera"
msgstr "Barva nadpisu banneru"

msgid "Farba hlavného nadpisu v banneri."
msgstr "Barva hlavního nadpisu v banneru."

msgid "Farba textu bannera"
msgstr "Barva textu banneru"

msgid "Farba popisu a bežného textu v banneri."
msgstr "Barva popisu a běžného textu v banneru."

msgid "Primárna / akcentová farba"
msgstr "Primární / akcentová barva"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Používá se jako záložní barva pro tlačítka a zvýraznění."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Průhlednost Cloud banneru (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Platí pouze pro typ banneru Cloud. 0 = maximálně průhledný, 100 = nejméně průhledný."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "Tlačítko \"Přijmout vše\" (primární)"

msgid "Farebné nastavenia pre hlavné modré tlačidlo súhlasu. Prázdne pole = použije sa primárna farba."
msgstr "Barevné nastavení pro hlavní modré tlačítko souhlasu. Prázdné pole = použije se primární barva."

msgid "Pozadie"
msgstr "Pozadí"

msgid "Pozadie (hover)"
msgstr "Pozadí (hover)"

msgid "Farba textu"
msgstr "Barva textu"

msgid "Farba textu (hover)"
msgstr "Barva textu (hover)"

msgid "Tlačidlo \"Odmietnuť všetky\" (primárne)"
msgstr "Tlačítko \"Odmítnout vše\" (primární)"

msgid "Farebné nastavenia pre tlačidlo odmietnutia. Možnosti sú zjednotené s tlačidlom \"Prijať všetky\"."
msgstr "Barevné nastavení pro tlačítko odmítnutí. Možnosti jsou sjednoceny s tlačítkem \"Přijmout vše\"."

msgid "Tlačidlo \"Spravovať nastavenia\" (outline)"
msgstr "Tlačítko \"Spravovat nastavení\" (outline)"

msgid "Farebné nastavenia pre tlačidlo správy preferencií."
msgstr "Barevné nastavení pro tlačítko správy preferencí."

msgid "Farba ohraničenia"
msgstr "Barva ohraničení"

msgid "Priehľadné"
msgstr "Průhledné"

msgid "Okno modálu (Spravovať súhlas)"
msgstr "Okno modalu (Spravovat souhlas)"

msgid "Farby pre okno nastavenia cookies, ktoré sa otvorí po kliknutí na \"Spravovať nastavenia\"."
msgstr "Barvy pro okno nastavení cookies, které se otevře po kliknutí na \"Spravovat nastavení\"."

msgid "Pozadie modálu"
msgstr "Pozadí modalu"

msgid "Farba identifikátora súhlasu"
msgstr "Barva identifikátoru souhlasu"

msgid "Pozadie hlavičky"
msgstr "Pozadí hlavičky"

