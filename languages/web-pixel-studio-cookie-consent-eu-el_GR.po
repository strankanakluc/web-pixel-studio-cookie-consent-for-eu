msgstr "Σχετικά με το plugin"

msgid "Jazyk:"
msgstr "Γλώσσα:"

msgid "Náhľad:"
msgstr "Προεπισκόπηση:"

msgid "Zobraziť banner"
msgstr "Εμφάνιση banner"

msgid "Nastavenia cookies"
msgstr "Ρυθμίσεις cookies"

msgid "Funguje na základe"
msgstr "Λειτουργεί βάσει"

msgid "Bezplatný plugin vytvoril:"
msgstr "Δωρεάν plugin από:"

msgid "Automatické spustenie"
msgstr "Αυτόματη εκκίνηση"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "Το banner θα εμφανιστεί αυτόματα κατά τη φόρτωση της σελίδας."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Συνιστούμε να το ενεργοποιήσετε. Απενεργοποιημένο = εμφάνιση χειροκίνητα μέσω <code>CookieConsentWPS.showBanner()</code>"

msgid "Vynútený súhlas"
msgstr "Υποχρεωτική συγκατάθεση"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "Ο χρήστης δεν μπορεί να περιηγηθεί στον ιστότοπο χωρίς να δώσει συγκατάθεση."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ Ο GDPR δεν επιβάλλει υποχρέωση αναγκαστικής συγκατάθεσης. Συνιστούμε ΑΠΕΝΕΡΓΟΠΟΙΗΣΗ – ο χρήστης έχει δικαίωμα άρνησης."

msgid "Automatické vymazanie cookies"
msgstr "Αυτόματη διαγραφή cookies"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "Κατά την ανάκληση της συγκατάθεσης, τα cookies της συγκεκριμένης κατηγορίας θα διαγραφούν αυτόματα."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Λειτουργεί μόνο για cookies που έχουν δηλωθεί στην καρτέλα Cookies. Συνιστούμε να το ενεργοποιήσετε."

msgid "Správa skriptov na stránke"
msgstr "Διαχείριση σεναρίων στη σελίδα"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Αποκλείει σενάρια τρίτων μέρη έως ότου ο χρήστης δώσει συγκατάθεση."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Ορίστε κανόνες στην καρτέλα \"Αποκλεισμός σεναρίων\". Το plugin θα αλλάξει τον τύπο του σεναρίου σε text/plain."

msgid "Skryť pre robotov"
msgstr "Απόκρυψη από bots"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "Το banner δεν θα εμφανιστεί σε μηχανές αναζήτησης και crawlers."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Συνιστούμε να το ενεργοποιήσετε. Βελτιώνει τη βαθμολογία SEO του ιστότοπου."

msgid "Opätovný súhlas"
msgstr "Ανανέωση συγκατάθεσης"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Εμφανίζει ξανά το banner όταν αλλάξει η λίστα των cookies."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Συνιστούμε να το ενεργοποιήσετε – ο GDPR απαιτεί νέα συγκατάθεση μετά από αλλαγή σκοπού επεξεργασίας."

msgid "Zaznamenávať súhlasy"
msgstr "Καταγραφή συγκαταθέσεων"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Κάθε συγκατάθεση αποθηκεύεται στη βάση δεδομένων (ID, IP, URL, ώρα)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Συνιστούμε να το ενεργοποιήσετε – τα αρχεία χρησιμεύουν ως απόδειξη συγκατάθεσης για έλεγχο GDPR."

msgid "Jazyk podľa návštevníka"
msgstr "Γλώσσα ανάλογα με τον επισκέπτη"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "Η μπάρα cookies του frontend θα προσπαθήσει να εντοπίσει τη γλώσσα του επισκέπτη και να εμφανίσει την αντίστοιχη διαθέσιμη μετάφραση."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Αν η γλώσσα του επισκέπτη δεν είναι διαθέσιμη, το plugin θα χρησιμοποιήσει English (GB). Αν η επιλογή είναι απενεργοποιημένη, το frontend χρησιμοποιεί τα τρέχοντα αποθηκευμένα κείμενα του banner."

msgid "Skryť prázdne kategórie"
msgstr "Απόκρυψη κενών κατηγοριών"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "Στο παράθυρο προτιμήσεων, θα αποκρυφθούν οι κατηγορίες χωρίς δηλωμένα cookies."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Ενεργοποιήστε όταν έχετε συμπληρώσει όλες τις κατηγορίες στην καρτέλα Cookies."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Καθυστέρηση εμφάνισης (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "Χρόνος σε χιλιοστά του δευτερολέπτου πριν από την εμφάνιση του banner."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 Τιμή 0 = αμέσως. Συνιστούμε 0–500 ms. Υψηλότερες τιμές μπορεί να αποτελούν πρόβλημα σε ελέγχους GDPR."

msgid "Platnosť súhlasu (dni)"
msgstr "Ισχύς συγκατάθεσης (ημέρες)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Μετά από πόσες ημέρες λήγει η συγκατάθεση και εμφανίζεται ξανά το banner."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 Ο GDPR συνιστά έως 13 μήνες (390 ημέρες). Η προεπιλογή των 182 ημερών (6 μήνες) είναι ασφαλής τιμή."

msgid "Cesta cookie"
msgstr "Διαδρομή cookie"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Η διαδρομή στην οποία το cookie θα ισχύει."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Αφήστε \"/\" – το cookie θα ισχύει σε ολόκληρο τον ιστότοπο."

msgid "Doména cookie"
msgstr "Τομέας cookie"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Αφήστε κενό για αυτόματη ανίχνευση."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Συμπληρώστε \".myweb.gr\" (με τελεία) εάν θέλετε να μοιράζεστε τη συγκατάθεση μεταξύ υποτομέων."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Τι είναι το Consent Mode;"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " Το Google Consent Mode επιτρέπει στην Google να μοντελοποιεί τα ελλείποντα δεδομένα όταν οι χρήστες αρνούνται αναλυτικά/διαφημιστικά cookies. Οι καμπάνιες σας θα παραμείνουν μετρήσιμες ακόμα και χωρίς πλήρη συγκατάθεση."

msgid "Verzia Consent Mode"
msgstr "Έκδοση Consent Mode"

msgid "Vypnuté"
msgstr "Απενεργοποιημένο"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "Το Consent Mode δεν χρησιμοποιείται. Κατάλληλο αν δεν χρησιμοποιείτε Google Analytics ή Ads."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "Πρότυπο από τον Μάρτιο 2024. Απαιτείται για Google Ads και GA4 στην ΕΕ. Στέλνει σήματα ad_user_data και ad_personalization. Απαραίτητο για remarketing και μετατροπές."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "Επέκταση του v2 με σήμα developer ID. Περιλαμβάνει όλες τις λειτουργίες του v2 + ρύθμιση developer_id για πιο ακριβή μοντελοποίηση μετατροπών. Κατάλληλο για προηγμένες λειτουργίες του Google Marketing Platform."

msgid "Odporúčané"
msgstr "Προτεινόμενο"

msgid "Nové"
msgstr "Νέο"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 Για τους περισσότερους ιστότοπους αρκεί το v2. Χρησιμοποιήστε το v3 αν χρησιμοποιείτε προηγμένες λειτουργίες Google Marketing Platform. Και οι δύο εκδόσεις απαιτούν GTM ή χειροκίνητη φόρτωση gtag.js."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Προαιρετικό: Το plugin θα φορτώσει αυτόματα το GTM."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Συμπληρώστε μόνο αν δεν φορτώνετε το GTM με άλλον τρόπο. Αν το GTM βρίσκεται στο θέμα ή σε άλλο plugin, αφήστε κενό."

msgid "Typ bannera"
msgstr "Τύπος banner"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – συμπαγές popup στη γωνία. Bar – οριζόντια λωρίδα σε όλο το πλάτος. Cloud – στρογγυλεμένο popup με μεγαλύτερη σκιά."

msgid "Poloha bannera"
msgstr "Θέση banner"

msgid "Dole vľavo"
msgstr "Κάτω αριστερά"

msgid "Dole vpravo"
msgstr "Κάτω δεξιά"

msgid "Dole v strede"
msgstr "Κάτω στο κέντρο"

msgid "Hore vľavo"
msgstr "Πάνω αριστερά"

msgid "Hore vpravo"
msgstr "Πάνω δεξιά"

msgid "Hore v strede"
msgstr "Πάνω στο κέντρο"

msgid "Stred obrazovky"
msgstr "Κέντρο οθόνης"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Εμφάνιση πλωτού εικονιδίου"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "Μετά από τη συγκατάθεση, εμφανίζεται εικονίδιο για εκ νέου διαχείριση των προτιμήσεων."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Συνιστούμε να το ενεργοποιήσετε – ο GDPR απαιτεί να μπορεί ο χρήστης να ανακαλεί τη συγκατάθεσή του ανά πάσα στιγμή. Κάνοντας κλικ στο εικονίδιο, εμφανίζεται πάνελ με το ID συγκατάθεσης και κουμπιά."

msgid "Poloha ikony"
msgstr "Θέση εικονιδίου"

msgid "Vertikálny margin ikony (px)"
msgstr "Κατακόρυφο περιθώριο εικονιδίου (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "Μετακινεί το εικονίδιο υψηλότερα ή χαμηλότερα από τη βασική θέση ανάλογα με την επιλεγμένη γωνία."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 Στην κάτω θέση, υψηλότερη τιμή ανεβάζει το εικονίδιο. Στην πάνω θέση, υψηλότερη τιμή το κατεβάζει."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Κατακόρυφο περιθώριο εικονιδίου σε κινητά (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Ισχύει μόνο για κινητές συσκευές (πλάτος έως 520 px)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Χρησιμοποιήστε αν θέλετε διαφορετικό ύψος εικονιδίου σε κινητά σε σχέση με τον υπολογιστή."

msgid "Typ ikony"
msgstr "Τύπος εικονιδίου"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Προσαρμοσμένο εικονίδιο (εικόνα)"

msgid "Vlastná ikona"
msgstr "Προσαρμοσμένο εικονίδιο"

msgid "Žiadny obrázok"
msgstr "Χωρίς εικόνα"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Επιλογή / μεταφόρτωση εικόνας"

msgid "Odstrániť"
msgstr "Αφαίρεση"

msgid "Pozadie floating ikony"
msgstr "Φόντο πλωτού εικονιδίου"

msgid "Farba kruhu floating ikony."
msgstr "Χρώμα του κύκλου του πλωτού εικονιδίου."

msgid "Pozadie floating ikony (hover)"
msgstr "Φόντο πλωτού εικονιδίου (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "Χρώμα του κύκλου του πλωτού εικονιδίου κατά το πέρασμα του ποντικιού."

msgid "Farba obsahu floating ikony"
msgstr "Χρώμα περιεχομένου πλωτού εικονιδίου"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "Χρώμα του εικονιδίου SVG ή του περιεχομένου στο πλωτό εικονίδιο."

msgid "Pozadie popupu floating ikony"
msgstr "Φόντο popup πλωτού εικονιδίου"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "Χρώμα φόντου του popup κατά το κλικ στο πλωτό εικονίδιο."

msgid "Farba textu popupu floating ikony"
msgstr "Χρώμα κειμένου popup πλωτού εικονιδίου"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "Χρώμα κειμένου και περιεχομένου του popup κατά το κλικ στο πλωτό εικονίδιο."

msgid "Zobraziť logo v banneri"
msgstr "Εμφάνιση λογοτύπου στο banner"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "Το λογότυπό σας θα εμφανιστεί στην επάνω δεξιά γωνία της μπάρας cookies."

msgid "Logo bannera"
msgstr "Λογότυπο banner"

msgid "Šírka loga (px)"
msgstr "Πλάτος λογοτύπου (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Πλάτος λογοτύπου σε pixel (20–100 px). Το ύψος προσαρμόζεται αυτόματα."

msgid "Font"
msgstr "Γραμματοσειρά"

msgid "CSS font-family hodnota"
msgstr "Τιμή CSS font-family"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "Το πεδίο προσφέρει μόνο γραμματοσειρές που εντοπίστηκαν από το θέμα, theme.json, Elementor και frontend CSS."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 Στη λίστα εμφανίζεται μόνο το όνομα γραμματοσειράς. Μετά την επιλογή, αποθηκεύεται η πλήρης τιμή font-family που εντοπίστηκε στη σελίδα. Η επιλογή \"Χρήση γραμματοσειράς θέματος\" αντιστοιχεί στην τιμή inherit."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Στρογγύλεμα κουμπιών (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = γωνιακά, 8 = ελαφρώς στρογγυλεμένα, 24+ = σχήμα \"pill\"."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Στρογγύλεμα banner / παραθύρου (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 Στρογγύλεμα γωνιών του banner και του παραθύρου. Προεπιλογή: 12 px."

msgid "Farby bannera"
msgstr "Χρώματα banner"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Ρυθμίστε τα χρώματα για το φόντο και το κείμενο της μπάρας cookies (banner)."

msgid "Pozadie bannera"
msgstr "Φόντο banner"

msgid "Farba pozadia cookie lišty."
msgstr "Χρώμα φόντου της μπάρας cookies."

msgid "Farba nadpisu bannera"
msgstr "Χρώμα τίτλου banner"

msgid "Farba hlavného nadpisu v banneri."
msgstr "Χρώμα του κύριου τίτλου στο banner."

msgid "Farba textu bannera"
msgstr "Χρώμα κειμένου banner"

msgid "Farba popisu a bežného textu v banneri."
msgstr "Χρώμα της περιγραφής και του κοινού κειμένου στο banner."

msgid "Primárna / akcentová farba"
msgstr "Κύριο / έντονο χρώμα"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Χρησιμοποιείται ως εφεδρικό χρώμα για κουμπιά και επισημάνσεις."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Αδιαφάνεια banner Cloud (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Ισχύει μόνο για τον τύπο banner Cloud. 0 = μέγιστη διαφάνεια, 100 = ελάχιστη διαφάνεια."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "Κουμπί \"Αποδοχή όλων\" (κύριο)"

