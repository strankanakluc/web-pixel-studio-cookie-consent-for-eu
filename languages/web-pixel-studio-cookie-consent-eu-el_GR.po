msgstr "Banner"

msgid "Kliknite na jazyk – všetky polia sa vyplnia automaticky. Potom kliknite Uložiť."
msgstr "Κάντε κλικ σε μια γλώσσα – όλα τα πεδία θα συμπληρωθούν αυτόματα. Στη συνέχεια κάντε κλικ στο Αποθήκευση."

msgid "Popis cookie je viditeľný návštevníkom v modáli preferencií – pomáha im pochopiť, na čo daná cookie slúži."
msgstr "Η περιγραφή του cookie είναι ορατή στους επισκέπτες στο παράθυρο προτιμήσεων – τους βοηθά να κατανοήσουν τον σκοπό του συγκεκριμένου cookie."

msgid "viditeľný návštevníkom"
msgstr "ορατό στους επισκέπτες"

msgid "Regex"
msgstr "Regex"

msgid "Žiadne cookies. Kliknite \"+ Pridať cookie\"."
msgstr "Δεν υπάρχουν cookies. Κάντε κλικ στο \"+ Προσθήκη cookie\"."

msgid "Cesta"
msgstr "Διαδρομή"

msgid "Viditeľný návštevníkom v modáli preferencií."
msgstr "Ορατό στους επισκέπτες στο παράθυρο προτιμήσεων."

msgid "napr. Používa sa Google Analytics na rozlíšenie návštevníkov."
msgstr "π.χ. Χρησιμοποιείται από το Google Analytics για διάκριση επισκεπτών."

msgid "Kategória"
msgstr "Κατηγορία"

msgid "Je Regex?"
msgstr "Είναι Regex;"

msgid "Email"
msgstr "Email"

