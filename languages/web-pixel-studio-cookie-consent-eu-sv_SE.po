msgstr "Förhandsgranskning:"

msgid "Zobraziť banner"
msgstr "Visa banner"

msgid "Nastavenia cookies"
msgstr "Cookieinställningar"

msgid "Funguje na základe"
msgstr "Drivs av"

msgid "Bezplatný plugin vytvoril:"
msgstr "Gratisplugin skapad av:"

msgid "Automatické spustenie"
msgstr "Automatisk start"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "Bannern visas automatiskt när sidan laddas."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Vi rekommenderar att aktivera. Inaktiverat = visa manuellt via <code>CookieConsentWPS.showBanner()</code>"

msgid "Vynútený súhlas"
msgstr "Tvingat samtycke"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "Användaren kan inte surfa på webbplatsen utan att ge samtycke."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ GDPR ålägger inte skyldighet att tvinga fram samtycke. Vi rekommenderar att INAKTIVERA – användaren har rätt att neka."

msgid "Automatické vymazanie cookies"
msgstr "Automatisk borttagning av cookies"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "Vid återkallelse av samtycke raderas cookies i den aktuella kategorin automatiskt."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Fungerar endast för cookies som deklarerats på fliken Cookies. Vi rekommenderar att aktivera."

msgid "Správa skriptov na stránke"
msgstr "Hantering av skript på sidan"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Blockerar tredjepartsskript tills användaren ger samtycke."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Definiera regler på fliken \"Skriptblockering\". Plugin ändrar skripttypen till text/plain."

msgid "Skryť pre robotov"
msgstr "Dölj för robotar"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "Bannern visas inte för sökmotorer och crawlers."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Vi rekommenderar att aktivera. Förbättrar webbplatsens SEO-poäng."

msgid "Opätovný súhlas"
msgstr "Förnyat samtycke"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Visar bannern igen när listan över cookies ändras."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Vi rekommenderar att aktivera – GDPR kräver nytt samtycke efter ändring av behandlingssyfte."

msgid "Zaznamenávať súhlasy"
msgstr "Logga samtycken"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Varje samtycke sparas i databasen (ID, IP, URL, tid)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Vi rekommenderar att aktivera – loggarna fungerar som bevis på samtycke vid GDPR-revision."

msgid "Jazyk podľa návštevníka"
msgstr "Språk enligt besökaren"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "Frontends cookiefält försöker identifiera besökarens språk och visa motsvarande tillgänglig översättning."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Om besökarens språk inte är tillgängligt använder plugin English (GB). Om alternativet är inaktiverat används de för tillfället sparade bannertexterna."

msgid "Skryť prázdne kategórie"
msgstr "Dölj tomma kategorier"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "I preferensfönstret döljs kategorier utan deklarerade cookies."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Aktivera när du har fyllt i alla kategorier på fliken Cookies."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Visningsfördröjning (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "Tid i millisekunder innan bannern visas."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 Värde 0 = omedelbart. Vi rekommenderar 0–500 ms. Högre värden kan vara problematiska vid GDPR-revisioner."

msgid "Platnosť súhlasu (dni)"
msgstr "Samtyckesgiltighetstid (dagar)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Efter hur många dagar löper samtycket ut och bannern visas igen."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 GDPR rekommenderar max. 13 månader (390 dagar). Standardvärdet 182 dagar (6 mån.) är ett säkert värde."

msgid "Cesta cookie"
msgstr "Cookiesökväg"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Sökvägen där cookien gäller."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Lämna \"/\" – cookien gäller på hela webbplatsen."

msgid "Doména cookie"
msgstr "Cookiedomän"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Lämna tomt för automatisk identifiering."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Fyll i \".myweb.se\" (med punkt) om du vill dela samtycke mellan underdomäner."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Vad är Consent Mode?"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " Google Consent Mode gör det möjligt för Google att modellera saknad data när användare avvisar analytiska/reklamcookies. Dina kampanjer kommer fortfarande att vara mätbara även utan fullständigt samtycke."

msgid "Verzia Consent Mode"
msgstr "Consent Mode-version"

msgid "Vypnuté"
msgstr "Inaktiverat"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "Consent Mode används inte. Lämpligt om du inte använder Google Analytics eller Ads."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "Standard sedan mars 2024. Krävs för Google Ads och GA4 inom EU. Skickar signalerna ad_user_data och ad_personalization. Nödvändigt för remarketing och konverteringar."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "Utökning av v2 med developer ID-signal. Inkluderar alla v2-funktioner + developer_id-inställning för mer exakt konverteringsmodellering. Lämpligt för avancerade Google Marketing Platform-funktioner."

msgid "Odporúčané"
msgstr "Rekommenderat"

msgid "Nové"
msgstr "Nytt"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 För de flesta webbplatser räcker v2. Använd v3 om du använder avancerade Google Marketing Platform-funktioner. Båda versionerna kräver GTM eller manuell inläsning av gtag.js."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Valfritt: Plugin laddar GTM automatiskt."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Fyll i endast om du inte laddar GTM på annat sätt. Om GTM finns i temat eller ett annat plugin, lämna tomt."

msgid "Typ bannera"
msgstr "Bannertyp"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – kompakt popup i hörnet. Bar – horisontellt fält över hela bredden. Cloud – avrundad popup med större skugga."

msgid "Poloha bannera"
msgstr "Bannerposition"

msgid "Dole vľavo"
msgstr "Nere till vänster"

msgid "Dole vpravo"
msgstr "Nere till höger"

msgid "Dole v strede"
msgstr "Nere i mitten"

msgid "Hore vľavo"
msgstr "Uppe till vänster"

msgid "Hore vpravo"
msgstr "Uppe till höger"

msgid "Hore v strede"
msgstr "Uppe i mitten"

msgid "Stred obrazovky"
msgstr "Skärmens mitt"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Visa flytande ikon"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "Efter att samtycke getts visas en ikon för att hantera inställningarna igen."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Vi rekommenderar att aktivera – GDPR kräver att användaren kan återkalla samtycket när som helst. När man klickar på ikonen visas en panel med samtyckes-ID och knappar."

msgid "Poloha ikony"
msgstr "Ikonposition"

msgid "Vertikálny margin ikony (px)"
msgstr "Ikonens vertikala marginal (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "Flyttar ikonen högre eller lägre från grundpositionen beroende på valt hörn."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 I nedre position lyfter ett högre värde ikonen uppåt. I övre position sänker ett högre värde den nedåt."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Ikonens vertikala marginal på mobil (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Gäller endast för mobila enheter (bredd upp till 520 px)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Använd om du vill ha en annan ikonhöjd på mobil jämfört med dator."

msgid "Typ ikony"
msgstr "Ikontyp"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Anpassad ikon (bild)"

msgid "Vlastná ikona"
msgstr "Anpassad ikon"

msgid "Žiadny obrázok"
msgstr "Ingen bild"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Välj / ladda upp bild"

msgid "Odstrániť"
msgstr "Ta bort"

msgid "Pozadie floating ikony"
msgstr "Bakgrund för flytande ikon"

msgid "Farba kruhu floating ikony."
msgstr "Färg på cirkeln för den flytande ikonen."

msgid "Pozadie floating ikony (hover)"
msgstr "Bakgrund för flytande ikon (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "Färg på cirkeln för den flytande ikonen vid hovring."

msgid "Farba obsahu floating ikony"
msgstr "Färg på innehållet i flytande ikon"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "Färg på SVG-ikonen eller innehållet i den flytande ikonen."

msgid "Pozadie popupu floating ikony"
msgstr "Bakgrund för flytande ikons popup"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "Bakgrundsfärg för popup vid klick på den flytande ikonen."

msgid "Farba textu popupu floating ikony"
msgstr "Textfärg för flytande ikons popup"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "Text- och innehållsfärg för popup vid klick på den flytande ikonen."

msgid "Zobraziť logo v banneri"
msgstr "Visa logotyp i bannern"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "Din logotyp visas i det övre högra hörnet av cookiefältet."

msgid "Logo bannera"
msgstr "Bannerns logotyp"

msgid "Šírka loga (px)"
msgstr "Logotypens bredd (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Logotypens bredd i pixlar (20–100 px). Höjden anpassas automatiskt."

msgid "Font"
msgstr "Typsnitt"

msgid "CSS font-family hodnota"
msgstr "CSS font-family-värde"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "Fältet erbjuder endast typsnitt som identifierats från temat, theme.json, Elementor och frontend-CSS."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 I listan visas endast typsnittsnamnet. Efter val sparas det fullständiga font-family-värdet som identifierats på sidan. Alternativet \"Använd temats typsnitt\" motsvarar värdet inherit."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Knapparnas avrundning (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = kantigt, 8 = lätt avrundat, 24+ = \"pill\"-form."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Bannerns / modalens avrundning (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 Avrundning av hörnen på bannern och modalen. Standard: 12 px."

msgid "Farby bannera"
msgstr "Bannerfärger"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Ställ in färger för bakgrund och text i cookiefältet (bannern)."

msgid "Pozadie bannera"
msgstr "Bannerbakgrund"

msgid "Farba pozadia cookie lišty."
msgstr "Bakgrundsfärg för cookiefältet."

msgid "Farba nadpisu bannera"
msgstr "Färg på bannerns rubrik"

msgid "Farba hlavného nadpisu v banneri."
msgstr "Färg på huvudrubriken i bannern."

msgid "Farba textu bannera"
msgstr "Bannertextfärg"

msgid "Farba popisu a bežného textu v banneri."
msgstr "Färg på beskrivning och vanlig text i bannern."

msgid "Primárna / akcentová farba"
msgstr "Primär / accentfärg"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Används som reservfärg för knappar och markeringar."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Genomskinlighet för Cloud-banner (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Gäller endast för bannertyp Cloud. 0 = maximalt genomskinlig, 100 = minimalt genomskinlig."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "Knapp \"Acceptera alla\" (primär)"

msgid "Farebné nastavenia pre hlavné modré tlačidlo súhlasu. Prázdne pole = použije sa primárna farba."
msgstr "Färginställningar för den primära blå samtyckesknappen. Tomt fält = primärfärgen används."

msgid "Pozadie"
msgstr "Bakgrund"

msgid "Pozadie (hover)"
msgstr "Bakgrund (hover)"

msgid "Farba textu"
msgstr "Textfärg"

msgid "Farba textu (hover)"
msgstr "Textfärg (hover)"

msgid "Tlačidlo \"Odmietnuť všetky\" (primárne)"
msgstr "Knapp \"Avvisa alla\" (primär)"

msgid "Farebné nastavenia pre tlačidlo odmietnutia. Možnosti sú zjednotené s tlačidlom \"Prijať všetky\"."
msgstr "Färginställningar för avvisningsknappen. Alternativen är enhetliga med knappen \"Acceptera alla\"."

msgid "Tlačidlo \"Spravovať nastavenia\" (outline)"
msgstr "Knapp \"Hantera inställningar\" (outline)"

msgid "Farebné nastavenia pre tlačidlo správy preferencií."
msgstr "Färginställningar för knappen för hantering av preferenser."

msgid "Farba ohraničenia"
msgstr "Kantfärg"

msgid "Priehľadné"
msgstr "Genomskinlig"

msgid "Okno modálu (Spravovať súhlas)"
msgstr "Modalfönster (Hantera samtycke)"

msgid "Farby pre okno nastavenia cookies, ktoré sa otvorí po kliknutí na \"Spravovať nastavenia\"."
msgstr "Färger för cookieinställningsfönstret som öppnas när man klickar på \"Hantera inställningar\"."

msgid "Pozadie modálu"
msgstr "Modalbakgrund"

msgid "Farba identifikátora súhlasu"
msgstr "Färg på samtyckes-ID"

msgid "Pozadie hlavičky"
msgstr "Rubrikbakgrund"

msgid "Pozadie päty"
msgstr "Sidfotsbakgrund"

msgid "Farba ohraničení"
msgstr "Kantfärger"

msgid "Pozadie kategórie"
msgstr "Kategoribakgrund"

msgid "Pozadie kategórie (hover)"
msgstr "Kategoribakgrund (hover)"

msgid "Farba prepínača (zapnutý)"
msgstr "Växlingsknappens färg (aktiv)"

msgid "Farba textu \"Vždy aktívne\""
msgstr "Textfärg \"Alltid aktiv\""

msgid "Zaoblenie modálu (px)"
msgstr "Modalens avrundning (px)"

msgid "Banner"
msgstr "Banner"

msgid "Kliknite na jazyk – všetky polia sa vyplnia automaticky. Potom kliknite Uložiť."
msgstr "Klicka på ett språk – alla fält fylls i automatiskt. Klicka sedan på Spara."

msgid "Popis cookie je viditeľný návštevníkom v modáli preferencií – pomáha im pochopiť, na čo daná cookie slúži."
msgstr "Cookiebeskrivningen är synlig för besökare i preferensfönstret – hjälper dem att förstå vad cookien används till."

msgid "viditeľný návštevníkom"
msgstr "synlig för besökare"

msgid "Regex"
msgstr "Regex"

msgid "Žiadne cookies. Kliknite \"+ Pridať cookie\"."
msgstr "Inga cookies. Klicka på \"+ Lägg till cookie\"."

msgid "Cesta"
msgstr "Sökväg"

msgid "Viditeľný návštevníkom v modáli preferencií."
msgstr "Synlig för besökare i preferensfönstret."

msgid "napr. Používa sa Google Analytics na rozlíšenie návštevníkov."
msgstr "t.ex. Används av Google Analytics för att skilja besökare åt."

msgid "Kategória"
msgstr "Kategori"

msgid "Je Regex?"
msgstr "Är Regex?"

msgid "Email"
msgstr "E-post"

msgid "Predmet"
msgstr "Ämne"

msgid "Text"
msgstr "Text"

msgid "Náhľad zoznamu cookies"
msgstr "Förhandsgranskning av cookielista"

msgid "Definujte zdroje skriptov, ktoré sa majú blokovať, kým používateľ neudelí súhlas pre danú kategóriu. Plugin zmení typ skriptu na text/plain, čo zabrání jeho spusteniu."
msgstr "Definiera skriptkällor som ska blockeras tills användaren ger samtycke för den kategorin. Plugin ändrar skripttypen till text/plain, vilket förhindrar att det körs."

msgid "Žiadne pravidlá blokovania."
msgstr "Inga blockeringsregler."

msgid "Zdroj skriptu"
msgstr "Skriptkälla"

msgid "Fragment URL, napr. \"google-analytics.com\""
msgstr "URL-fragment, t.ex. \"google-analytics.com\""

msgid "Nev."
msgstr "Nöd."

msgid "Anal."
msgstr "Ana."

msgid "Market."
msgstr "Mark."

msgid "Pref."
msgstr "Pref."

msgid "ID súhlasu návštevníka"
msgstr "Besökarens samtyckes-ID"

msgid "Zobrazí jedinečné ID súhlasu aktuálneho návštevníka. Vhodné pre zásady ochrany osobných údajov – umožní používateľovi preukázať, kedy a ako súhlasil."
msgstr "Visar det unika samtyckes-ID:t för den aktuella besökaren. Lämpligt för integritetspolicyer – gör det möjligt för användaren att bevisa när och hur de samtyckte."

msgid "Parameter"
msgstr "Parameter"

msgid "Predvolené"
msgstr "Standard"

msgid "Text pred ID."
msgstr "Text före ID."

msgid "HTML obal (p, div, span…)"
msgstr "HTML-behållare (p, div, span…)"

msgid "Zoznam cookies používaných na webe"
msgstr "Lista över cookies som används på webbplatsen"

msgid "Automaticky zobrazí prehľadnú tabuľku všetkých deklarovaných cookies, rozdelenú podľa kategórií. Vložte na stránku s cookie politikou."
msgstr "Visar automatiskt en tydlig tabell över alla deklarerade cookies, uppdelad per kategori. Infoga på sidan med cookiepolicyn."

msgid "Filtruj: necessary, analytics, targeting, preferences"
msgstr "Filtrera: necessary, analytics, targeting, preferences"

msgid "Tlačidlo správy súhlasu"
msgstr "Knapp för samtyckeshantering"

msgid "Vloží tlačidlo, ktoré otvorí modál nastavenia cookies. Vhodné pre stránky so zásadami ochrany osobných údajov a právne dokumenty – umožní návštevníkovi kedykoľvek zmeniť preferencie."
msgstr "Infogar en knapp som öppnar cookieinställningsmodalen. Lämpligt för sidor med integritetspolicy och juridiska dokument – gör det möjligt för besökaren att ändra preferenser när som helst."

msgid "Text tlačidla (predvolene: text z nastavení Prekladov)."
msgstr "Knapptexten (standard: text från översättningsinställningarna)."

msgid "CSS trieda pre vlastné štýlovanie."
msgstr "CSS-klass för anpassad formatering."

msgid "Voliteľné HTML id atribút."
msgstr "Valfritt HTML id-attribut."

msgid "Exportuje všetky nastavenia do JSON súboru. Vhodné pre presun medzi servermi alebo zálohu."
msgstr "Exporterar alla inställningar till en JSON-fil. Lämpligt för överföring mellan servrar eller säkerhetskopiering."

msgid "Nahrajte predtým exportovaný settings.json. Prepisuje aktuálnu konfiguráciu."
msgstr "Ladda upp ett tidigare exporterat settings.json. Skriver över den aktuella konfigurationen."

msgid "Kliknite alebo presuňte settings.json sem"
msgstr "Klicka eller dra settings.json hit"

msgid "Resetuje všetky nastavenia na predvolené hodnoty (SK jazyk, predvolený vzhľad). Deklarácie cookies, pravidlá blokovania a záznamy súhlasov nie sú ovplyvnené."
msgstr "Återställer alla inställningar till standardvärden (SK-språk, standardutseende). Cookiedeklarationer, blockeringsregler och samtyckesloggar påverkas inte."

msgid "Verzia"
msgstr "Version"

msgid "Deklarácie cookies"
msgstr "Cookiedeklarationer"

msgid "Pravidlá blokovania"
msgstr "Blockeringsregler"

msgid "O plugine Web Pixel Studio Cookie Consent for EU"
msgstr "Om plugin Web Pixel Studio Cookie Consent for EU"

msgid "Popis pluginu"
msgstr "Pluginbeskrivning"

msgid "Hlavné funkcie"
msgstr "Huvudfunktioner"

msgid "Cookie banner"
msgstr "Cookiebanner"

msgid "Prispôsobiteľný popup/bar/cloud banner s výberom polohy na stránke."
msgstr "Anpassningsbar popup/bar/cloud-banner med val av position på sidan."

msgid "Modál preferencií"
msgstr "Preferensfönster"

msgid "Používateľ si môže zvoliť, ktoré kategórie cookies povolí (nevyhnutné, analytické, marketingové, preferenčné)."
msgstr "Användaren kan välja vilka kategorier av cookies som tillåts (nödvändiga, analytiska, marknadsföring, preferenser)."

msgid "Každý súhlas sa uloží do databázy s ID, IP adresou, URL a časovou pečiatkou. Export do CSV."
msgstr "Varje samtycke sparas i databasen med ID, IP-adress, URL och tidsstämpel. Export till CSV."

msgid "Skripty tretích strán (napr. Google Analytics, Meta Pixel) sa zablokujú, kým používateľ neudelí súhlas."
msgstr "Tredjepartsskript (t.ex. Google Analytics, Meta Pixel) blockeras tills användaren ger samtycke."

msgid "Predpripravené sady cookies a skriptov"
msgstr "Förinställda cookie- och skriptpaket"

msgid "Hotové predvoľby jedným kliknutím doplnia bežné Google a Meta cookies spolu so súvisiacimi pravidlami blokovania."
msgstr "Färdiga förinställningar lägger med ett klick till vanliga Google- och Meta-cookies tillsammans med tillhörande blockeringsregler."

msgid "Consent Mode v2 / v3"
msgstr "Consent Mode v2 / v3"

msgid "Automaticky nastaví default denied stav a aktualizuje Google signály po udelení súhlasu."
msgstr "Ställer automatiskt in standard nekad-status och uppdaterar Google-signaler efter att samtycke getts."

msgid "Plné prispôsobenie vzhľadu"
msgstr "Fullständig anpassning av utseende"

msgid "Farby, font, zaoblenie tlačidiel, rozloženie bannera, poloha floating ikony."
msgstr "Färger, typsnitt, knapparnas avrundning, bannerlayout, flytande ikonens position."

msgid "9 jazykových predvolieb"
msgstr "9 språkförinställningar"

msgid "SK, EN, CS, DE, FR, ES, PL, HU, IT. Všetky texty sú plne editovateľné z admin panelu."
msgstr "SK, EN, CS, DE, FR, ES, PL, HU, IT. Alla texter är fullt redigerbara från adminpanelen."

msgid "[ccwps_consent_id] – zobrazí ID súhlasu návštevníka. [ccwps_cookie_list] – tabuľka deklarovaných cookies. [ccwps_manage_consent] – tlačidlo na správu súhlasu."
msgstr "[ccwps_consent_id] – visar besökarens samtyckes-ID. [ccwps_cookie_list] – tabell över deklarerade cookies. [ccwps_manage_consent] – knapp för samtyckeshantering."

msgid "Export/Import nastavení"
msgstr "Export/import av inställningar"

msgid "Detekcia robotov"
msgstr "Robotidentifiering"

msgid "Banner sa automaticky skryje pred vyhľadávačmi a crawlermi."
msgstr "Bannern döljs automatiskt för sökmotorer och crawlers."

msgid "Ak sa zmení zoznam cookies, plugin automaticky požiada o nový súhlas."
msgstr "Om listan över cookies ändras begär plugin automatiskt nytt samtycke."

msgid "Floating ikona"
msgstr "Flytande ikon"

msgid "Plávajúca ikona umožní používateľovi kedykoľvek zmeniť preferencie. Po kliknutí zobrazí ID súhlasu a dátum."
msgstr "Den flytande ikonen gör det möjligt för användaren att ändra preferenser när som helst. Vid klick visas samtyckes-ID och datum."

msgid "Postup nastavenia"
msgstr "Installationsprocess"

msgid "V záložke Nastavenia zapnite Zaznamenávať súhlasy, Opätovný súhlas, Skryť pre robotov a Automatické spustenie. Vyberte verziu Consent Mode (v2 pre väčšinu webov). Ak používate GTM, vyplňte GTM Container ID."
msgstr "På fliken Inställningar aktivera Logga samtycken, Förnyat samtycke, Dölj för robotar och Automatisk start. Välj Consent Mode-version (v2 för de flesta webbplatser). Om du använder GTM, fyll i GTM Container ID."

msgid "V záložke Preklady vyberte jazyk pomocou rýchlych predvolieb alebo upravte texty manuálne. Kliknite Uložiť preklady."
msgstr "På fliken Översättningar välj språk med snabbförinställningar eller redigera texter manuellt. Klicka på Spara översättningar."

msgid "V záložke Vzhľad nastavte farby, rozloženie bannera a polohu plávajúcej ikony. Použite tlačidlá Náhľad na overenie zmien."
msgstr "På fliken Utseende ställ in färger, bannerlayout och position för den flytande ikonen. Använd förhandsgranskningsknapparna för att kontrollera ändringar."

msgid "Deklarácia cookies"
msgstr "Cookiedeklaration"

msgid "V záložke Cookies pridajte všetky cookies, ktoré váš web používa. Pre každú cookie vyplňte názov, doménu, platnosť, popis a kategóriu. Popis bude viditeľný návštevníkovi."
msgstr "På fliken Cookies lägg till alla cookies som din webbplats använder. För varje cookie fyll i namn, domän, giltighet, beskrivning och kategori. Beskrivningen är synlig för besökare."

msgid "V záložke Blokovanie skriptov pridajte pravidlá pre skripty, ktoré chcete blokovať. Napr. pre Google Analytics pridajte \"google-analytics.com\" → kategória Analytické."
msgstr "På fliken Skriptblockering lägg till regler för skript som du vill blockera. T.ex. för Google Analytics lägg till \"google-analytics.com\" → kategori Analytiska."

msgid "Cookie politika"
msgstr "Cookiepolicy"

msgid "Na stránku s Cookie politikou vložte [ccwps_cookie_list] pre automatickú tabuľku cookies, [ccwps_consent_id] pre zobrazenie ID súhlasu a [ccwps_manage_consent] pre tlačidlo zmeny preferencií."
msgstr "På sidan med Cookiepolicyn infoga [ccwps_cookie_list] för den automatiska cookietabellen, [ccwps_consent_id] för att visa samtyckes-ID och [ccwps_manage_consent] för knappen för att ändra preferenser."

msgid "Overenie"
msgstr "Verifiering"

msgid "Otvorte web v incognito okne a overte, že sa banner zobrazí, súhlas sa zaznamená v záložke Záznamy súhlasov a floating ikona funguje správne."
msgstr "Öppna webbplatsen i ett inkognitofönster och kontrollera att bannern visas, samtycket loggas på fliken Samtyckeslogg och den flytande ikonen fungerar korrekt."

msgid "Nastavenie Google Tag Manager + Consent Mode"
msgstr "Inställning av Google Tag Manager + Consent Mode"

msgid "Možnosť A: Plugin načíta GTM automaticky"
msgstr "Alternativ A: Plugin laddar GTM automatiskt"

msgid "V záložke Nastavenia vyplňte GTM Container ID (napr. GTM-XXXXXXX). Plugin automaticky vloží GTM kód do hlavičky stránky spolu s Consent Mode default stavom (všetky signály = denied). Po udelení súhlasu sa GTM aktualizuje pomocou gtag('consent', 'update', ...)."
msgstr "På fliken Inställningar fyll i GTM Container ID (t.ex. GTM-XXXXXXX). Plugin infogar automatiskt GTM-koden i sidhuvudet tillsammans med Consent Mode standardstatus (alla signaler = denied). Efter att samtycke getts uppdateras GTM via gtag('consent', 'update', ...)."

msgid "Možnosť B: GTM máte nainštalovaný inak (téma, iný plugin)"
msgstr "Alternativ B: GTM är installerat på annat sätt (tema, annat plugin)"

msgid "Nechajte GTM Container ID prázdne. Plugin automaticky vloží Consent Mode default stav pred GTM kód, takže default denied signály sa nastavia skôr, ako GTM spustí akékoľvek tagy. Toto je správne správanie podľa Google dokumentácie."
msgstr "Lämna GTM Container ID tomt. Plugin infogar automatiskt Consent Mode standardstatus före GTM-koden, så att standardnekade signaler ställs in innan GTM aktiverar några taggar. Detta är korrekt beteende enligt Googles dokumentation."

msgid "Nastavenie tagov v GTM"
msgstr "Inställning av taggar i GTM"

msgid "V GTM nastavte pre každý tag Consent Settings. Pre Google Analytics (GA4): analytics_storage = Required. Pre Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Tagy sa spustia len po udelení príslušného súhlasu."
msgstr "I GTM ställ in Consent Settings för varje tagg. För Google Analytics (GA4): analytics_storage = Required. För Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Taggar aktiveras endast efter att relevant samtycke getts."

msgid "Overenie pomocou Google Tag Assistant"
msgstr "Verifiering med Google Tag Assistant"

msgid "Otvorte Google Tag Assistant a overte, že pri odmietnutí cookies sú tagy v stave \"Consent Blocked\" a po udelení súhlasu sa aktivujú. Skontrolujte tiež Google Analytics Realtime report."
msgstr "Öppna Google Tag Assistant och kontrollera att taggar är i status \"Consent Blocked\" vid avvisning av cookies och aktiveras efter att samtycke getts. Kontrollera även Google Analytics realtidsrapport."

msgid "Autor a podpora"
msgstr "Upphovsman och support"

msgid "Plugin vytvoril Web Pixel Studio. Pre otázky, návrhy alebo hlásenie chýb nás kontaktujte na:"
msgstr "Plugin skapades av Web Pixel Studio. För frågor, förslag eller felrapportering, kontakta oss på:"

msgid "Plugin je bezplatný a open-source pod licenciou GPL-2.0. Postavený na:"
msgstr "Plugin är gratis och öppen källkod under GPL-2.0-licensen. Byggt med:"

msgid "Použiť font témy"
msgstr "Använd temats typsnitt"

msgid "Nepodarilo sa odoslať žiadosť. Skúste to znova."
msgstr "Det gick inte att skicka förfrågan. Försök igen."

msgid "Zadajte platný e-mail."
msgstr "Ange en giltig e-postadress."

msgid "Predmet musí mať 3 až 150 znakov."
msgstr "Ämnet måste ha 3 till 150 tecken."

msgid "Text správy musí mať 20 až 4000 znakov."
msgstr "Meddelandetexten måste ha 20 till 4000 tecken."

msgid "Počkajte prosím 30 sekúnd a skúste to znova."
msgstr "Vänta 30 sekunder och försök igen."

msgid "Dosiahli ste limit 3 žiadostí za 10 minút. Skúste to neskôr."
msgstr "Du har nått gränsen på 3 förfrågningar per 10 minuter. Försök senare."

msgid "Denný limit žiadostí bol dosiahnutý. Skúste to zajtra."
msgstr "Den dagliga förfrågningsgränsen har uppnåtts. Försök imorgon."

msgid "Žiadosť sa nepodarilo odoslať z tohto WordPress webu. Skontrolujte SMTP/mail konfiguráciu hostingu."
msgstr "Det gick inte att skicka förfrågan från den här WordPress-webbplatsen. Kontrollera hostingens SMTP/e-postkonfiguration."

msgid "Detail chyby: %s"
msgstr "Feldetalj: %s"

msgid "Žiadosť bola úspešne odoslaná."
msgstr "Förfrågan skickades framgångsrikt."

msgid "Cookie settings"
msgstr "Cookieinställningar"

msgid "Súhlas nebol udelený."
msgstr "Samtycke gavs inte."

msgid "Žiadne cookies nie sú deklarované."
msgstr "Inga cookies är deklarerade."
