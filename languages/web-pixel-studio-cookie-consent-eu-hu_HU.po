msgstr "HTML-burkoló (p, div, span…)"

msgid "Zoznam cookies používaných na webe"
msgstr "A weboldalon használt cookie-k listája"

msgid "Automaticky zobrazí prehľadnú tabuľku všetkých deklarovaných cookies, rozdelenú podľa kategórií. Vložte na stránku s cookie politikou."
msgstr "Automatikusan megjeleníti az összes deklarált cookie áttekinthető táblázatát, kategóriák szerint rendezve. Illessze be a cookie-szabályzat oldalára."

msgid "Filtruj: necessary, analytics, targeting, preferences"
msgstr "Szűrő: necessary, analytics, targeting, preferences"

msgid "Tlačidlo správy súhlasu"
msgstr "Hozzájárulás-kezelő gomb"

msgid "Vloží tlačidlo, ktoré otvorí modál nastavenia cookies. Vhodné pre stránky so zásadami ochrany osobných údajov a právne dokumenty – umožní návštevníkovi kedykoľvek zmeniť preferencie."
msgstr "Beilleszt egy gombot, amely megnyitja a cookie-beállítások modális ablakát. Alkalmas adatvédelmi irányelvek oldalaihoz és jogi dokumentumokhoz – lehetővé teszi a látogató számára, hogy bármikor módosítsa a beállításait."

msgid "Text tlačidla (predvolene: text z nastavení Prekladov)."
msgstr "Gomb szövege (alapértelmezett: szöveg a Fordítások beállításaiból)."

msgid "CSS trieda pre vlastné štýlovanie."
msgstr "CSS-osztály az egyéni stílushoz."

msgid "Voliteľné HTML id atribút."
msgstr "Opcionális HTML id attribútum."

msgid "Exportuje všetky nastavenia do JSON súboru. Vhodné pre presun medzi servermi alebo zálohu."
msgstr "Exportálja az összes beállítást JSON-fájlba. Alkalmas szerverek közötti átvitelre vagy biztonsági mentésre."

msgid "Nahrajte predtým exportovaný settings.json. Prepisuje aktuálnu konfiguráciu."
msgstr "Töltsön fel egy korábban exportált settings.json fájlt. Felülírja az aktuális konfigurációt."

msgid "Kliknite alebo presuňte settings.json sem"
msgstr "Kattintson vagy húzza ide a settings.json fájlt"

msgid "Resetuje všetky nastavenia na predvolené hodnoty (SK jazyk, predvolený vzhľad). Deklarácie cookies, pravidlá blokovania a záznamy súhlasov nie sú ovplyvnené."
msgstr "Visszaállítja az összes beállítást az alapértelmezett értékekre (SK nyelv, alapértelmezett megjelenés). A cookie-deklarációk, blokkolási szabályok és hozzájárulási naplók nem érintettek."

msgid "Verzia"
msgstr "Verzió"

msgid "Deklarácie cookies"
msgstr "Cookie-deklarációk"

msgid "Pravidlá blokovania"
msgstr "Blokkolási szabályok"

msgid "O plugine Web Pixel Studio Cookie Consent for EU"
msgstr "A Web Pixel Studio Cookie Consent for EU bővítményről"

msgid "Popis pluginu"
msgstr "Bővítmény leírása"

msgid "Hlavné funkcie"
msgstr "Főbb funkciók"

msgid "Cookie banner"
msgstr "Cookie-banner"

msgid "Prispôsobiteľný popup/bar/cloud banner s výberom polohy na stránke."
msgstr "Testreszabható popup/bar/cloud banner pozícióválasztással az oldalon."

msgid "Modál preferencií"
msgstr "Preferencia-modális ablak"

msgid "Používateľ si môže zvoliť, ktoré kategórie cookies povolí (nevyhnutné, analytické, marketingové, preferenčné)."
msgstr "A felhasználó kiválaszthatja, hogy mely cookie-kategóriákat engedélyezi (szükséges, analitikai, marketing, preferenciák)."

msgid "Každý súhlas sa uloží do databázy s ID, IP adresou, URL a časovou pečiatkou. Export do CSV."
msgstr "Minden hozzájárulás mentésre kerül az adatbázisba azonosítóval, IP-címmel, URL-lel és időbélyeggel. Exportálás CSV-be."

msgid "Skripty tretích strán (napr. Google Analytics, Meta Pixel) sa zablokujú, kým používateľ neudelí súhlas."
msgstr "Harmadik féltől származó szkriptek (pl. Google Analytics, Meta Pixel) blokkolva vannak, amíg a felhasználó nem adja meg a hozzájárulást."

msgid "Predpripravené sady cookies a skriptov"
msgstr "Előre definiált cookie- és szkriptkészletek"

msgid "Hotové predvoľby jedným kliknutím doplnia bežné Google a Meta cookies spolu so súvisiacimi pravidlami blokovania."
msgstr "A kész előbeállítások egy kattintással hozzáadják a szokásos Google és Meta cookie-kat a kapcsolódó blokkolási szabályokkal együtt."

msgid "Consent Mode v2 / v3"
msgstr "Consent Mode v2 / v3"

msgid "Automaticky nastaví default denied stav a aktualizuje Google signály po udelení súhlasu."
msgstr "Automatikusan beállítja az alapértelmezett elutasított állapotot, és a hozzájárulás megadása után frissíti a Google jeleket."

msgid "Plné prispôsobenie vzhľadu"
msgstr "Teljes megjelenés-testreszabás"

msgid "Farby, font, zaoblenie tlačidiel, rozloženie bannera, poloha floating ikony."
msgstr "Színek, betűtípus, gombok lekerekítése, banner-elrendezés, lebegő ikon pozíciója."

msgid "9 jazykových predvolieb"
msgstr "9 nyelvi előbeállítás"

msgid "SK, EN, CS, DE, FR, ES, PL, HU, IT. Všetky texty sú plne editovateľné z admin panelu."
msgstr "SK, EN, CS, DE, FR, ES, PL, HU, IT. Minden szöveg teljesen szerkeszthető az adminisztrátori panelről."

msgid "[ccwps_consent_id] – zobrazí ID súhlasu návštevníka. [ccwps_cookie_list] – tabuľka deklarovaných cookies. [ccwps_manage_consent] – tlačidlo na správu súhlasu."
msgstr "[ccwps_consent_id] – megjeleníti a látogató hozzájárulási azonosítóját. [ccwps_cookie_list] – a deklarált cookie-k táblázata. [ccwps_manage_consent] – hozzájárulás-kezelő gomb."

msgid "Export/Import nastavení"
msgstr "Beállítások exportálása/importálása"

msgid "Detekcia robotov"
msgstr "Robot-felismerés"

msgid "Banner sa automaticky skryje pred vyhľadávačmi a crawlermi."
msgstr "A banner automatikusan elrejtőzik a keresőmotorok és crawlerek elől."

msgid "Ak sa zmení zoznam cookies, plugin automaticky požiada o nový súhlas."
msgstr "Ha a cookie-lista megváltozik, a bővítmény automatikusan kér új hozzájárulást."

msgid "Floating ikona"
msgstr "Lebegő ikon"

msgid "Plávajúca ikona umožní používateľovi kedykoľvek zmeniť preferencie. Po kliknutí zobrazí ID súhlasu a dátum."
msgstr "A lebegő ikon lehetővé teszi a felhasználó számára, hogy bármikor módosítsa a preferenciákat. Kattintásra megjeleníti a hozzájárulási azonosítót és a dátumot."

msgid "Postup nastavenia"
msgstr "Beállítási útmutató"

msgid "V záložke Nastavenia zapnite Zaznamenávať súhlasy, Opätovný súhlas, Skryť pre robotov a Automatické spustenie. Vyberte verziu Consent Mode (v2 pre väčšinu webov). Ak používate GTM, vyplňte GTM Container ID."
msgstr "A Beállítások fülön kapcsolja be a Hozzájárulások naplózása, Megújított hozzájárulás, Elrejtés robotok elől és Automatikus indítás funkciókat. Válassza ki a Consent Mode verzióját (v2 a legtöbb weboldalhoz). Ha GTM-et használ, töltse ki a GTM Container ID mezőt."

msgid "V záložke Preklady vyberte jazyk pomocou rýchlych predvolieb alebo upravte texty manuálne. Kliknite Uložiť preklady."
msgstr "A Fordítások fülön válasszon nyelvet a gyors előbeállítások segítségével, vagy szerkessze a szövegeket kézzel. Kattintson a Fordítások mentése gombra."

msgid "V záložke Vzhľad nastavte farby, rozloženie bannera a polohu plávajúcej ikony. Použite tlačidlá Náhľad na overenie zmien."
msgstr "A Megjelenés fülön állítsa be a színeket, a banner-elrendezést és a lebegő ikon pozícióját. Használja az Előnézet gombokat a változtatások ellenőrzéséhez."

msgid "Deklarácia cookies"
msgstr "Cookie-deklaráció"

msgid "V záložke Cookies pridajte všetky cookies, ktoré váš web používa. Pre každú cookie vyplňte názov, doménu, platnosť, popis a kategóriu. Popis bude viditeľný návštevníkovi."
msgstr "A Cookie-k fülön adja hozzá az összes cookie-t, amelyet a weboldala használ. Minden cookie-hoz töltse ki a nevet, domaint, érvényességet, leírást és kategóriát. A leírás látható lesz a látogatók számára."

msgid "V záložke Blokovanie skriptov pridajte pravidlá pre skripty, ktoré chcete blokovať. Napr. pre Google Analytics pridajte \"google-analytics.com\" → kategória Analytické."
msgstr "A Szkript-blokkolás fülön adja hozzá a blokkolni kívánt szkriptek szabályait. Pl. a Google Analytics esetén adja hozzá a \"google-analytics.com\" → Analitikai kategória szabályt."

msgid "Cookie politika"
msgstr "Cookie-szabályzat"

msgid "Na stránku s Cookie politikou vložte [ccwps_cookie_list] pre automatickú tabuľku cookies, [ccwps_consent_id] pre zobrazenie ID súhlasu a [ccwps_manage_consent] pre tlačidlo zmeny preferencií."
msgstr "A Cookie-szabályzat oldalon illessze be a [ccwps_cookie_list] shortcode-ot az automatikus cookie-táblázathoz, a [ccwps_consent_id] shortcode-ot a hozzájárulási azonosító megjelenítéséhez és a [ccwps_manage_consent] shortcode-ot a preferenciák módosítása gombhoz."

msgid "Overenie"
msgstr "Ellenőrzés"

msgid "Otvorte web v incognito okne a overte, že sa banner zobrazí, súhlas sa zaznamená v záložke Záznamy súhlasov a floating ikona funguje správne."
msgstr "Nyissa meg a weboldalt inkognitó ablakban, és ellenőrizze, hogy a banner megjelenik-e, a hozzájárulás rögzítésre kerül-e a Hozzájárulási naplók fülön, és a lebegő ikon megfelelően működik-e."

msgid "Nastavenie Google Tag Manager + Consent Mode"
msgstr "Google Tag Manager + Consent Mode beállítása"

msgid "Možnosť A: Plugin načíta GTM automaticky"
msgstr "A lehetőség: A bővítmény automatikusan betölti a GTM-et"

msgid "V záložke Nastavenia vyplňte GTM Container ID (napr. GTM-XXXXXXX). Plugin automaticky vloží GTM kód do hlavičky stránky spolu s Consent Mode default stavom (všetky signály = denied). Po udelení súhlasu sa GTM aktualizuje pomocou gtag('consent', 'update', ...)."
msgstr "A Beállítások fülön töltse ki a GTM Container ID mezőt (pl. GTM-XXXXXXX). A bővítmény automatikusan beilleszti a GTM kódot az oldal fejlécébe a Consent Mode alapértelmezett állapotával (minden jel = denied). A hozzájárulás megadása után a GTM a gtag('consent', 'update', ...) segítségével frissül."

msgid "Možnosť B: GTM máte nainštalovaný inak (téma, iný plugin)"
msgstr "B lehetőség: A GTM másképp van telepítve (téma, másik bővítmény)"

msgid "Nechajte GTM Container ID prázdne. Plugin automaticky vloží Consent Mode default stav pred GTM kód, takže default denied signály sa nastavia skôr, ako GTM spustí akékoľvek tagy. Toto je správne správanie podľa Google dokumentácie."
msgstr "Hagyja üresen a GTM Container ID mezőt. A bővítmény automatikusan beilleszti a Consent Mode alapértelmezett állapotát a GTM kód elé, így az alapértelmezett elutasított jelek beállításra kerülnek, mielőtt a GTM bármilyen taget aktiválna. Ez a helyes viselkedés a Google dokumentációja szerint."

msgid "Nastavenie tagov v GTM"
msgstr "Tagek beállítása a GTM-ben"

msgid "V GTM nastavte pre každý tag Consent Settings. Pre Google Analytics (GA4): analytics_storage = Required. Pre Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Tagy sa spustia len po udelení príslušného súhlasu."
msgstr "A GTM-ben állítsa be a Consent Settings-t minden taghez. A Google Analytics (GA4) esetén: analytics_storage = Required. A Google Ads esetén: ad_storage, ad_user_data, ad_personalization = Required. A tagek csak a megfelelő hozzájárulás megadása után aktiválódnak."

msgid "Overenie pomocou Google Tag Assistant"
msgstr "Ellenőrzés a Google Tag Assistant segítségével"

msgid "Otvorte Google Tag Assistant a overte, že pri odmietnutí cookies sú tagy v stave \"Consent Blocked\" a po udelení súhlasu sa aktivujú. Skontrolujte tiež Google Analytics Realtime report."
msgstr "Nyissa meg a Google Tag Assistantet, és ellenőrizze, hogy a cookie-k elutasításakor a tagek \"Consent Blocked\" állapotban vannak-e, és a hozzájárulás megadása után aktiválódnak-e. Ellenőrizze a Google Analytics Valós idejű jelentést is."

msgid "Autor a podpora"
msgstr "Szerző és támogatás"

msgid "Plugin vytvoril Web Pixel Studio. Pre otázky, návrhy alebo hlásenie chýb nás kontaktujte na:"
msgstr "A bővítményt a Web Pixel Studio készítette. Kérdések, javaslatok vagy hibajelentések esetén lépjen kapcsolatba velünk:"

msgid "Plugin je bezplatný a open-source pod licenciou GPL-2.0. Postavený na:"
msgstr "A bővítmény ingyenes és nyílt forráskódú, GPL-2.0 licenc alatt. Épül erre:"

msgid "Použiť font témy"
msgstr "Téma betűtípusának használata"

msgid "Nepodarilo sa odoslať žiadosť. Skúste to znova."
msgstr "A kérés elküldése sikertelen. Próbálja újra."

msgid "Zadajte platný e-mail."
msgstr "Adjon meg érvényes e-mail-címet."

msgid "Predmet musí mať 3 až 150 znakov."
msgstr "A tárgynak 3 és 150 karakter közöttinek kell lennie."

msgid "Text správy musí mať 20 až 4000 znakov."
msgstr "Az üzenet szövegének 20 és 4000 karakter közöttinek kell lennie."

msgid "Počkajte prosím 30 sekúnd a skúste to znova."
msgstr "Kérjük, várjon 30 másodpercet, majd próbálja újra."

msgid "Dosiahli ste limit 3 žiadostí za 10 minút. Skúste to neskôr."
msgstr "Elérte a 10 percenkénti 3 kérés limitjét. Próbálja újra később."

msgid "Denný limit žiadostí bol dosiahnutý. Skúste to zajtra."
msgstr "A napi kérelemkorlát elérve. Próbálja újra holnap."

msgid "Žiadosť sa nepodarilo odoslať z tohto WordPress webu. Skontrolujte SMTP/mail konfiguráciu hostingu."
msgstr "A kérést nem sikerült elküldeni erről a WordPress-weboldalról. Ellenőrizze a tárhely SMTP/mail konfigurációját."

msgid "Detail chyby: %s"
msgstr "Hiba részletei: %s"

msgid "Žiadosť bola úspešne odoslaná."
msgstr "A kérés sikeresen elküldve."

msgid "Cookie settings"
msgstr "Cookie-beállítások"

msgid "Súhlas nebol udelený."
msgstr "A hozzájárulás nem lett megadva."

msgid "Žiadne cookies nie sú deklarované."
msgstr "Nincsenek deklarált cookie-k."
