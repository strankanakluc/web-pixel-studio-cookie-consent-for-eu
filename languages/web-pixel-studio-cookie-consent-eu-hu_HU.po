msgid "Nastavenia boli importované."
msgstr "A beállítások importálása megtörtént."

msgid "Import zlyhal. Skontrolujte súbor."
msgstr "Az importálás sikertelen. Ellenőrizze a fájlt."

msgid "Vzhľad"
msgstr "Megjelenés"

msgid "Preklady"
msgstr "Fordítások"

msgid "Cookies"
msgstr "Cookie-k"

msgid "Blokovanie skriptov"
msgstr "Szkript-blokkolás"

msgid "Záznamy súhlasov"
msgstr "Hozzájárulási naplók"

msgid "Shortcodes"
msgstr "Shortcode-ok"

msgid "Nástroje"
msgstr "Eszközök"

msgid "O plugine"
msgstr "A bővítményről"

msgid "Jazyk:"
msgstr "Nyelv:"

msgid "Náhľad:"
msgstr "Előnézet:"

msgid "Zobraziť banner"
msgstr "Banner megjelenítése"

msgid "Nastavenia cookies"
msgstr "Cookie-beállítások"

msgid "Funguje na základe"
msgstr "Alapja"

msgid "Bezplatný plugin vytvoril:"
msgstr "Az ingyenes bővítményt készítette:"

msgid "Automatické spustenie"
msgstr "Automatikus indítás"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "A banner automatikusan megjelenik az oldal betöltésekor."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Javasoljuk a bekapcsolást. Kikapcsolva = manuálisan jelenítse meg a <code>CookieConsentWPS.showBanner()</code> segítségével"

msgid "Vynútený súhlas"
msgstr "Kényszerített hozzájárulás"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "A felhasználó nem böngészheti a weboldalt hozzájárulás megadása nélkül."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ A GDPR nem ír elő kötelező hozzájárulás-kikényszerítést. Javasoljuk a KIKAPCSOLÁST – a felhasználónak joga van elutasítani."

msgid "Automatické vymazanie cookies"
msgstr "Cookie-k automatikus törlése"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "A hozzájárulás visszavonásakor az adott kategória cookie-jai automatikusan törlődnek."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Csak a Cookie-k fülön deklarált cookie-kra vonatkozik. Javasoljuk a bekapcsolást."

msgid "Správa skriptov na stránke"
msgstr "Szkriptkezelés az oldalon"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Blokkolja a harmadik féltől származó szkripteket, amíg a felhasználó nem adja meg a hozzájárulást."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Határozza meg a szabályokat a \"Szkript-blokkolás\" fülön. A bővítmény text/plain típusra változtatja a szkript típusát."

msgid "Skryť pre robotov"
msgstr "Elrejtés robotok elől"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "A banner nem jelenik meg a keresőmotorok és crawlerek számára."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Javasoljuk a bekapcsolást. Javítja a weboldal SEO-pontszámát."

msgid "Opätovný súhlas"
msgstr "Megújított hozzájárulás"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Újra megjeleníti a bannert, ha a cookie-lista megváltozik."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Javasoljuk a bekapcsolást – a GDPR új hozzájárulást követel meg az adatkezelési cél megváltozása után."

msgid "Zaznamenávať súhlasy"
msgstr "Hozzájárulások naplózása"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Minden hozzájárulás mentésre kerül az adatbázisba (ID, IP, URL, idő)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Javasoljuk a bekapcsolást – a naplók hozzájárulási bizonyítékként szolgálnak a GDPR-audithoz."

msgid "Jazyk podľa návštevníka"
msgstr "Nyelv a látogató szerint"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "A frontend cookie-sáv megpróbálja felismerni a látogató nyelvét, és megjeleníti a megfelelő elérhető fordítást."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Ha a látogató nyelve nem érhető el, a bővítmény az English (GB) nyelvet használja. Ha az opció ki van kapcsolva, a frontend az aktuálisan mentett bannertextusokat használja."

msgid "Skryť prázdne kategórie"
msgstr "Üres kategóriák elrejtése"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "A preferencia-ablakban elrejtjük a deklarált cookie-k nélküli kategóriákat."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Kapcsolja be, ha a Cookie-k fülön minden kategóriát kitöltött."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Megjelenítési késleltetés (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "A banner megjelenítése előtti idő ezredmásodpercben."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 0 érték = azonnal. 0–500 ms-t ajánlunk. A magasabb értékek problémát okozhatnak a GDPR-auditoknál."

msgid "Platnosť súhlasu (dni)"
msgstr "Hozzájárulás érvényessége (nap)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Hány nap elteltével jár le a hozzájárulás, és jelenik meg újra a banner."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 A GDPR max. 13 hónapot (390 nap) ajánl. Az alapértelmezett 182 nap (6 hónap) biztonságos érték."

msgid "Cesta cookie"
msgstr "Cookie elérési útja"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Az elérési út, amelyen a cookie érvényes lesz."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Hagyja \"/\" – a cookie az egész weboldalon érvényes lesz."

msgid "Doména cookie"
msgstr "Cookie domainje"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Hagyja üresen az automatikus felismeréshez."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Adja meg \".weboldalem.hu\" (ponttal) ha a hozzájárulást aldomainek között szeretné megosztani."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Mi a Consent Mode?"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " A Google Consent Mode lehetővé teszi a Google számára, hogy modellezze a hiányzó adatokat, amikor a felhasználók elutasítják az analitikai/reklám cookie-kat. Kampányai továbbra is mérhetők maradnak teljes hozzájárulás nélkül is."

msgid "Verzia Consent Mode"
msgstr "Consent Mode verziója"

msgid "Vypnuté"
msgstr "Kikapcsolva"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "A Consent Mode nincs használatban. Megfelelő, ha nem használja a Google Analytics-t vagy Ads-t."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "2024 márciusa óta szabvány. Az EU-ban szükséges a Google Ads-hoz és GA4-hez. Elküldi az ad_user_data és ad_personalization jeleket. Szükséges a remarketinghez és a konverziókhoz."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "A v2 kiegészítése developer ID jellel. Tartalmazza az összes v2 funkciót + developer_id beállítást a pontosabb konverzió-modellezéshez. Megfelelő a fejlett Google Marketing Platform funkciókhoz."

msgid "Odporúčané"
msgstr "Ajánlott"

msgid "Nové"
msgstr "Új"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 A legtöbb weboldalnak elég a v2. Használja a v3-at, ha fejlett Google Marketing Platform funkciókat használ. Mindkét verzióhoz GTM vagy a gtag.js manuális betöltése szükséges."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Opcionális: A bővítmény automatikusan betölti a GTM-et."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Csak akkor töltse ki, ha a GTM-et nem tölti be más módon. Ha a GTM a témában vagy egy másik bővítményben van, hagyja üresen."

msgid "Typ bannera"
msgstr "Banner típusa"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – kompakt popup a sarokban. Bar – vízszintes sáv teljes szélességben. Cloud – lekerekített popup nagyobb árnyékkal."

msgid "Poloha bannera"
msgstr "Banner pozíciója"

msgid "Dole vľavo"
msgstr "Bal alul"

msgid "Dole vpravo"
msgstr "Jobb alul"

msgid "Dole v strede"
msgstr "Középen alul"

msgid "Hore vľavo"
msgstr "Bal felül"

msgid "Hore vpravo"
msgstr "Jobb felül"

msgid "Hore v strede"
msgstr "Középen felül"

msgid "Stred obrazovky"
msgstr "Képernyő közepe"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Lebegő ikon megjelenítése"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "A hozzájárulás megadása után megjelenik egy ikon a preferenciák újbóli kezeléséhez."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Javasoljuk a bekapcsolást – a GDPR előírja, hogy a felhasználó bármikor visszavonhassa a hozzájárulást. Az ikonra kattintva megjelenik a hozzájárulási azonosítót és gombokat tartalmazó panel."

msgid "Poloha ikony"
msgstr "Ikon pozíciója"

msgid "Vertikálny margin ikony (px)"
msgstr "Ikon függőleges margója (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "A kiválasztott saroktól függően magasabbra vagy lejjebb tolja az ikont az alappozíciótól."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 Alsó pozícióban a magasabb érték felemeli az ikont. Felső pozícióban a magasabb érték lejjebb tolja."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Ikon függőleges margója mobilon (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Csak mobileszközökre vonatkozik (520 px-ig széles)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Használja, ha mobilon más ikonmagasságot szeretne, mint asztali gépen."

msgid "Typ ikony"
msgstr "Ikon típusa"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Egyéni ikon (kép)"

msgid "Vlastná ikona"
msgstr "Egyéni ikon"

msgid "Žiadny obrázok"
msgstr "Nincs kép"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Kép kiválasztása / feltöltése"

msgid "Odstrániť"
msgstr "Eltávolítás"

msgid "Pozadie floating ikony"
msgstr "Lebegő ikon háttere"

msgid "Farba kruhu floating ikony."
msgstr "A lebegő ikon körének színe."

msgid "Pozadie floating ikony (hover)"
msgstr "Lebegő ikon háttere (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "A lebegő ikon körének színe egérrámutatáskor."

msgid "Farba obsahu floating ikony"
msgstr "Lebegő ikon tartalmának színe"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "Az SVG ikon vagy a lebegő ikonban lévő tartalom színe."

msgid "Pozadie popupu floating ikony"
msgstr "Lebegő ikon felugró ablakának háttere"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "A felugró ablak hátterének színe a lebegő ikonra kattintás után."

msgid "Farba textu popupu floating ikony"
msgstr "Lebegő ikon felugró ablakának szövegszíne"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "A felugró ablak szövegének és tartalmának színe a lebegő ikonra kattintás után."

msgid "Zobraziť logo v banneri"
msgstr "Logó megjelenítése a bannerben"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "A logója megjelenik a cookie-sáv jobb felső sarkában."

msgid "Logo bannera"
msgstr "Banner logója"

msgid "Šírka loga (px)"
msgstr "Logó szélessége (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Logó szélessége pixelben (20–100 px). A magasság automatikusan igazodik."

msgid "Font"
msgstr "Betűtípus"

msgid "CSS font-family hodnota"
msgstr "CSS font-family érték"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "A mező csak a témából, theme.json-ból, Elementorból és frontend CSS-ből észlelt betűtípusokat kínálja."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 A listában csak a betűtípus neve jelenik meg. A kiválasztás után az oldalon észlelt teljes font-family érték kerül mentésre. A \"Téma betűtípusának használata\" opció az inherit értéknek felel meg."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Gombok lekerekítése (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = szögletes, 8 = enyhén lekerekített, 24+ = \"pill\" alakú."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Banner / modális ablak lekerekítése (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 A banner és a modális ablak sarkainak lekerekítése. Alapértelmezett: 12 px."

msgid "Farby bannera"
msgstr "Banner színei"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Állítsa be a cookie-sáv (banner) hátterének és szövegének színeit."

msgid "Pozadie bannera"
msgstr "Banner háttere"

msgid "Farba pozadia cookie lišty."
msgstr "A cookie-sáv háttérszíne."

msgid "Farba nadpisu bannera"
msgstr "Banner fejlécének színe"

msgid "Farba hlavného nadpisu v banneri."
msgstr "A banner fő fejlécének színe."

msgid "Farba textu bannera"
msgstr "Banner szövegszíne"

msgid "Farba popisu a bežného textu v banneri."
msgstr "A leírás és az általános szöveg színe a bannerben."

msgid "Primárna / akcentová farba"
msgstr "Elsődleges / hangsúlyszín"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Tartalék színként használják a gombokhoz és kiemelésekhez."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Cloud banner átlátszósága (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Csak a Cloud banner típusra vonatkozik. 0 = maximálisan átlátszó, 100 = legkevésbé átlátszó."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "\"Összes elfogadása\" gomb (elsődleges)"

msgid "Farebné nastavenia pre hlavné modré tlačidlo súhlasu. Prázdne pole = použije sa primárna farba."
msgstr "Színbeállítások a fő hozzájárulási gombhoz. Üres mező = az elsődleges szín kerül alkalmazásra."

msgid "Pozadie"
msgstr "Háttér"

msgid "Pozadie (hover)"
msgstr "Háttér (hover)"

msgid "Farba textu"
msgstr "Szöveg színe"

msgid "Farba textu (hover)"
msgstr "Szöveg színe (hover)"

msgid "Tlačidlo \"Odmietnuť všetky\" (primárne)"
msgstr "\"Összes elutasítása\" gomb (elsődleges)"

msgid "Farebné nastavenia pre tlačidlo odmietnutia. Možnosti sú zjednotené s tlačidlom \"Prijať všetky\"."
msgstr "Színbeállítások az elutasítás gombhoz. A lehetőségek egységesek az \"Összes elfogadása\" gombbal."

msgid "Tlačidlo \"Spravovať nastavenia\" (outline)"
msgstr "\"Beállítások kezelése\" gomb (körvonal)"

msgid "Farebné nastavenia pre tlačidlo správy preferencií."
msgstr "Színbeállítások a preferenciák kezelése gombhoz."

msgid "Farba ohraničenia"
msgstr "Keret színe"

msgid "Priehľadné"
msgstr "Átlátszó"

msgid "Okno modálu (Spravovať súhlas)"
msgstr "Modális ablak (Hozzájárulás kezelése)"

msgid "Farby pre okno nastavenia cookies, ktoré sa otvorí po kliknutí na \"Spravovať nastavenia\"."
msgstr "Színek a cookie-beállítások ablakhoz, amely a \"Beállítások kezelése\" gombra kattintás után nyílik meg."

msgid "Pozadie modálu"
msgstr "Modális ablak háttere"

msgid "Farba identifikátora súhlasu"
msgstr "Hozzájárulási azonosító színe"

msgid "Pozadie hlavičky"
msgstr "Fejléc háttere"

msgid "Pozadie päty"
msgstr "Lábléc háttere"

msgid "Farba ohraničení"
msgstr "Keretek színe"

msgid "Pozadie kategórie"
msgstr "Kategória háttere"

msgid "Pozadie kategórie (hover)"
msgstr "Kategória háttere (hover)"

msgid "Farba prepínača (zapnutý)"
msgstr "Kapcsoló színe (bekapcsolva)"

