msgstr "Eelvaade:"

msgid "Zobraziť banner"
msgstr "Kuva bänner"

msgid "Nastavenia cookies"
msgstr "Küpsiste seaded"

msgid "Funguje na základe"
msgstr "Põhineb"

msgid "Bezplatný plugin vytvoril:"
msgstr "Tasuta plugini lõi:"

msgid "Automatické spustenie"
msgstr "Automaatne käivitamine"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "Bänner kuvatakse automaatselt lehe laadimisel."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Soovitame sisse lülitada. Väljas = kuva käsitsi <code>CookieConsentWPS.showBanner()</code> kaudu"

msgid "Vynútený súhlas"
msgstr "Kohustuslik nõusolek"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "Kasutaja ei saa veebisaiti sirvida ilma nõusolekut andmata."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ GDPR ei kohusta nõusolekut sundima. Soovitame VÄLJA LÜLITADA – kasutajal on õigus keelduda."

msgid "Automatické vymazanie cookies"
msgstr "Küpsiste automaatne kustutamine"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "Nõusoleku tühistamisel kustutatakse selle kategooria küpsised automaatselt."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Töötab ainult vahekaardil Küpsised deklareeritud küpsiste jaoks. Soovitame sisse lülitada."

msgid "Správa skriptov na stránke"
msgstr "Skriptide haldamine lehel"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Blokeerib kolmandate osapoolte skripte, kuni kasutaja annab nõusoleku."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Määrake reeglid vahekaardil \"Skriptide blokeerimine\". Plugin muudab skripti tüübi text/plain'iks."

msgid "Skryť pre robotov"
msgstr "Peida robotite eest"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "Bännerit ei kuvata otsimootorite ega veebiroomijaite eest."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Soovitame sisse lülitada. Parandab veebisaidi SEO skoori."

msgid "Opätovný súhlas"
msgstr "Uuesti nõusolek"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Kuvab bänneri uuesti, kui küpsiste loend muutub."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Soovitame sisse lülitada – GDPR nõuab uut nõusolekut pärast töötlemise eesmärgi muutmist."

msgid "Zaznamenávať súhlasy"
msgstr "Nõusolekute logimine"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Iga nõusolek salvestatakse andmebaasi (ID, IP, URL, aeg)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Soovitame sisse lülitada – logid toimivad nõusoleku tõendina GDPR auditi jaoks."

msgid "Jazyk podľa návštevníka"
msgstr "Keel vastavalt külastajale"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "Esipoolne küpsisteriba üritab tuvastada külastaja keele ja kuvada vastava saadaoleva tõlke."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Kui külastaja keel pole saadaval, kasutab plugin English (GB). Kui valik on välja lülitatud, kasutab esipool praegu salvestatud bänneri tekste."

msgid "Skryť prázdne kategórie"
msgstr "Peida tühjad kategooriad"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "Eelistuste aknas peidetakse kategooriad, millel pole deklareeritud küpsiseid."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Lülitage sisse, kui olete vahekaardil Küpsised kõik kategooriad täitnud."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Kuvamise viivitus (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "Aeg millisekundites enne bänneri kuvamist."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 Väärtus 0 = kohe. Soovitame 0–500 ms. Kõrgemad väärtused võivad olla probleem GDPR auditite puhul."

msgid "Platnosť súhlasu (dni)"
msgstr "Nõusoleku kehtivus (päevad)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Mitu päeva pärast nõusolek aegub ja bänner kuvatakse uuesti."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 GDPR soovitab maks. 13 kuud (390 päeva). Vaikimisi 182 päeva (6 kuud) on turvaline väärtus."

msgid "Cesta cookie"
msgstr "Küpsise tee"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Tee, millel küpsis kehtib."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Jätke \"/\" – küpsis kehtib kogu veebisaidil."

msgid "Doména cookie"
msgstr "Küpsise domeen"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Jätke tühjaks automaatse tuvastamise jaoks."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Täitke \".myweb.ee\" (koos punktiga), kui soovite nõusolekut alamdomeenide vahel jagada."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Mis on Consent Mode?"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " Google Consent Mode võimaldab Google'il modelleerida puuduvaid andmeid, kui kasutajad keelduvad analüütika-/reklaamiküpsistest. Teie kampaaniad on endiselt mõõdetavad ka ilma täieliku nõusolekuta."

msgid "Verzia Consent Mode"
msgstr "Consent Mode versioon"

msgid "Vypnuté"
msgstr "Väljas"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "Consent Mode ei kasutata. Sobib, kui te ei kasuta Google Analyticsit ega Adsi."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "Standard alates märtsist 2024. Vajalik Google Adsi ja GA4 jaoks ELis. Saadab signaalid ad_user_data ja ad_personalization. Vajalik remarketingi ja konversioonide jaoks."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "v2 laiendus developer ID signaali võrra. Sisaldab kõiki v2 funktsioone + developer_id seadistust täpsemaks konversioonide modelleerimiseks. Sobib Google Marketing Platvormi täiustatud funktsioonide jaoks."

msgid "Odporúčané"
msgstr "Soovitatud"

msgid "Nové"
msgstr "Uus"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 Enamiku veebisaitide jaoks piisab v2-st. Kasutage v3, kui kasutate Google Marketing Platvormi täiustatud funktsioone. Mõlemad versioonid nõuavad GTM-i või gtag.js käsitsi laadimist."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Valikuline: Plugin laadib GTM-i automaatselt."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Täitke ainult siis, kui te ei laadi GTM-i muul viisil. Kui GTM on teemas või muus pluginas, jätke tühjaks."

msgid "Typ bannera"
msgstr "Bänneri tüüp"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – kompaktne hüpikaken nurgas. Bar – horisontaalne riba üle kogu laiuse. Cloud – ümardatud hüpikaken suurema varjuga."

msgid "Poloha bannera"
msgstr "Bänneri asukoht"

msgid "Dole vľavo"
msgstr "All vasakul"

msgid "Dole vpravo"
msgstr "All paremal"

msgid "Dole v strede"
msgstr "All keskel"

msgid "Hore vľavo"
msgstr "Üleval vasakul"

msgid "Hore vpravo"
msgstr "Üleval paremal"

msgid "Hore v strede"
msgstr "Üleval keskel"

msgid "Stred obrazovky"
msgstr "Ekraani keskosa"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Kuva ujuv ikoon"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "Pärast nõusoleku andmist ilmub ikoon eelistuste uuesti haldamiseks."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Soovitame sisse lülitada – GDPR nõuab, et kasutaja saaks nõusoleku igal ajal tühistada. Ikoonil klõpsates kuvatakse paneel nõusoleku ID ja nuppudega."

msgid "Poloha ikony"
msgstr "Ikooni asukoht"

msgid "Vertikálny margin ikony (px)"
msgstr "Ikooni vertikaalne veeris (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "Nihutab ikooni valitud nurga põhiasukohast kõrgemale või madalamale."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 Alumisel asukohal tõstab suurem väärtus ikooni üles. Ülemisel asukohal nihutab suurem väärtus seda allapoole."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Ikooni vertikaalne veeris mobiilil (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Kehtib ainult mobiilseadmete jaoks (laius kuni 520 px)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Kasutage, kui soovite mobiilil erineva kõrgusega ikooni võrreldes lauaarvutiga."

msgid "Typ ikony"
msgstr "Ikooni tüüp"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Kohandatud ikoon (pilt)"

msgid "Vlastná ikona"
msgstr "Kohandatud ikoon"

msgid "Žiadny obrázok"
msgstr "Pilt puudub"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Vali / laadi üles pilt"

msgid "Odstrániť"
msgstr "Eemalda"

msgid "Pozadie floating ikony"
msgstr "Ujuva ikooni taust"

msgid "Farba kruhu floating ikony."
msgstr "Ujuva ikooni ringi värv."

msgid "Pozadie floating ikony (hover)"
msgstr "Ujuva ikooni taust (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "Ujuva ikooni ringi värv hiirega üle liikumisel."

msgid "Farba obsahu floating ikony"
msgstr "Ujuva ikooni sisu värv"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "SVG-ikooni või ujuva ikooni sisu värv."

msgid "Pozadie popupu floating ikony"
msgstr "Ujuva ikooni hüpikakna taust"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "Hüpikakna tausta värv ujuval ikoonil klõpsates."

msgid "Farba textu popupu floating ikony"
msgstr "Ujuva ikooni hüpikakna teksti värv"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "Hüpikakna teksti ja sisu värv ujuval ikoonil klõpsates."

msgid "Zobraziť logo v banneri"
msgstr "Kuva logo bänneris"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "Teie logo kuvatakse küpsisteriba paremas ülanurgas."

msgid "Logo bannera"
msgstr "Bänneri logo"

msgid "Šírka loga (px)"
msgstr "Logo laius (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Logo laius pikslites (20–100 px). Kõrgus kohandub automaatselt."

msgid "Font"
msgstr "Font"

msgid "CSS font-family hodnota"
msgstr "CSS font-family väärtus"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "Väli pakub ainult teemast, theme.json-ist, Elementorist ja esipoolse CSS-ist tuvastatud fonte."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 Loendis kuvatakse ainult fondi nimi. Pärast valimist salvestatakse lehel tuvastatud täielik font-family väärtus. Valik \"Kasuta teema fonti\" vastab väärtusele inherit."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Nuppude ümarotsad (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = kandiline, 8 = kergelt ümardatud, 24+ = \"pill\" kuju."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Bänneri / modaali ümarotsad (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 Bänneri ja modaali nurkade ümardamine. Vaikimisi: 12 px."

msgid "Farby bannera"
msgstr "Bänneri värvid"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Seadistage küpsisteriba (bänneri) tausta ja teksti värvid."

msgid "Pozadie bannera"
msgstr "Bänneri taust"

msgid "Farba pozadia cookie lišty."
msgstr "Küpsisteriba taustvärv."

msgid "Farba nadpisu bannera"
msgstr "Bänneri pealkirja värv"

msgid "Farba hlavného nadpisu v banneri."
msgstr "Bänneris oleva põhipealkirja värv."

msgid "Farba textu bannera"
msgstr "Bänneri teksti värv"

msgid "Farba popisu a bežného textu v banneri."
msgstr "Kirjelduse ja tavateksti värv bänneris."

msgid "Primárna / akcentová farba"
msgstr "Esmane / rõhuvärv"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Kasutatakse nuppude ja esiletõstude tagavaravärvina."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Bänneri Cloud läbipaistvus (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Kehtib ainult bänneri tüübi Cloud puhul. 0 = maksimaalselt läbipaistev, 100 = minimaalselt läbipaistev."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "Nupp \"Nõustu kõigiga\" (esmane)"

msgid "Farebné nastavenia pre hlavné modré tlačidlo súhlasu. Prázdne pole = použije sa primárna farba."
msgstr "Põhilise sinise nõusoleksnupu värvisätted. Tühi väli = kasutatakse esmast värvi."

msgid "Pozadie"
msgstr "Taust"

msgid "Pozadie (hover)"
msgstr "Taust (hover)"

msgid "Farba textu"
msgstr "Teksti värv"

msgid "Farba textu (hover)"
msgstr "Teksti värv (hover)"

msgid "Tlačidlo \"Odmietnuť všetky\" (primárne)"
msgstr "Nupp \"Keeldu kõigest\" (esmane)"

msgid "Farebné nastavenia pre tlačidlo odmietnutia. Možnosti sú zjednotené s tlačidlom \"Prijať všetky\"."
msgstr "Keeldumise nupu värvisätted. Valikud on ühendatud nupuga \"Nõustu kõigiga\"."

msgid "Tlačidlo \"Spravovať nastavenia\" (outline)"
msgstr "Nupp \"Halda seadeid\" (outline)"

msgid "Farebné nastavenia pre tlačidlo správy preferencií."
msgstr "Eelistuste haldamise nupu värvisätted."

msgid "Farba ohraničenia"
msgstr "Äärise värv"

msgid "Priehľadné"
msgstr "Läbipaistev"

msgid "Okno modálu (Spravovať súhlas)"
msgstr "Modaaliaken (Halda nõusolekut)"

msgid "Farby pre okno nastavenia cookies, ktoré sa otvorí po kliknutí na \"Spravovať nastavenia\"."
msgstr "Värvid küpsiste seadistamisakna jaoks, mis avaneb klõpsates \"Halda seadeid\"."

msgid "Pozadie modálu"
msgstr "Modaali taust"

msgid "Farba identifikátora súhlasu"
msgstr "Nõusoleku identifikaatori värv"

msgid "Pozadie hlavičky"
msgstr "Päise taust"

msgid "Pozadie päty"
msgstr "Jaluse taust"

msgid "Farba ohraničení"
msgstr "Ääriste värv"

msgid "Pozadie kategórie"
msgstr "Kategooria taust"

msgid "Pozadie kategórie (hover)"
msgstr "Kategooria taust (hover)"

msgid "Farba prepínača (zapnutý)"
msgstr "Lüliti värv (sees)"

msgid "Farba textu \"Vždy aktívne\""
msgstr "Teksti värv \"Alati aktiivne\""

msgid "Zaoblenie modálu (px)"
msgstr "Modaali ümarotsad (px)"

msgid "Banner"
msgstr "Bänner"

msgid "Kliknite na jazyk – všetky polia sa vyplnia automaticky. Potom kliknite Uložiť."
msgstr "Klõpsake keelel – kõik väljad täidetakse automaatselt. Seejärel klõpsake Salvesta."

msgid "Popis cookie je viditeľný návštevníkom v modáli preferencií – pomáha im pochopiť, na čo daná cookie slúži."
msgstr "Küpsise kirjeldus on külastajatele eelistuste aknas nähtav – aitab neil mõista, milleks see küpsis on."

msgid "viditeľný návštevníkom"
msgstr "nähtav külastajatele"

msgid "Regex"
msgstr "Regex"

msgid "Žiadne cookies. Kliknite \"+ Pridať cookie\"."
msgstr "Küpsiseid pole. Klõpsake \"+ Lisa küpsis\"."

msgid "Cesta"
msgstr "Tee"

msgid "Viditeľný návštevníkom v modáli preferencií."
msgstr "Nähtav külastajatele eelistuste aknas."

msgid "napr. Používa sa Google Analytics na rozlíšenie návštevníkov."
msgstr "nt. Kasutatakse Google Analytics'is külastajate eristamiseks."

msgid "Kategória"
msgstr "Kategooria"

msgid "Je Regex?"
msgstr "On Regex?"

msgid "Email"
msgstr "E-post"

msgid "Predmet"
msgstr "Teema"

msgid "Text"
msgstr "Tekst"

msgid "Náhľad zoznamu cookies"
msgstr "Küpsiste loendi eelvaade"

msgid "Definujte zdroje skriptov, ktoré sa majú blokovať, kým používateľ neudelí súhlas pre danú kategóriu. Plugin zmení typ skriptu na text/plain, čo zabrání jeho spusteniu."
msgstr "Määrake skriptiallikad, mis tuleks blokeerida, kuni kasutaja annab nõusoleku selle kategooria jaoks. Plugin muudab skripti tüübi text/plain'iks, mis takistab selle käivitamist."

msgid "Žiadne pravidlá blokovania."
msgstr "Blokeerimisreeglid puuduvad."

msgid "Zdroj skriptu"
msgstr "Skriptiallikas"

msgid "Fragment URL, napr. \"google-analytics.com\""
msgstr "URL-i fragment, nt \"google-analytics.com\""

msgid "Nev."
msgstr "Vaj."

msgid "Anal."
msgstr "Ana."

msgid "Market."
msgstr "Tur."

msgid "Pref."
msgstr "Eeli."

msgid "ID súhlasu návštevníka"
msgstr "Külastaja nõusoleku ID"

msgid "Zobrazí jedinečné ID súhlasu aktuálneho návštevníka. Vhodné pre zásady ochrany osobných údajov – umožní používateľovi preukázať, kedy a ako súhlasil."
msgstr "Kuvab praeguse külastaja ainulaadse nõusoleku ID. Sobib privaatsuspoliitikate jaoks – võimaldab kasutajal tõendada, millal ja kuidas ta nõustus."

msgid "Parameter"
msgstr "Parameeter"

msgid "Predvolené"
msgstr "Vaikimisi"

msgid "Text pred ID."
msgstr "Tekst enne ID-d."

msgid "HTML obal (p, div, span…)"
msgstr "HTML-ümbris (p, div, span…)"

msgid "Zoznam cookies používaných na webe"
msgstr "Veebisaidil kasutatavate küpsiste loend"

msgid "Automaticky zobrazí prehľadnú tabuľku všetkých deklarovaných cookies, rozdelenú podľa kategórií. Vložte na stránku s cookie politikou."
msgstr "Kuvab automaatselt selge tabeli kõigist deklareeritud küpsistest, jagatuna kategooriate kaupa. Lisage küpsisepoliitika lehele."

msgid "Filtruj: necessary, analytics, targeting, preferences"
msgstr "Filtreeri: necessary, analytics, targeting, preferences"

msgid "Tlačidlo správy súhlasu"
msgstr "Nõusoleku haldamise nupp"

msgid "Vloží tlačidlo, ktoré otvorí modál nastavenia cookies. Vhodné pre stránky so zásadami ochrany osobných údajov a právne dokumenty – umožní návštevníkovi kedykoľvek zmeniť preferencie."
msgstr "Lisab nupu, mis avab küpsiste seadistamise modaali. Sobib privaatsuspoliitika lehtede ja õiguslike dokumentide jaoks – võimaldab külastajal eelistusi igal ajal muuta."

msgid "Text tlačidla (predvolene: text z nastavení Prekladov)."
msgstr "Nupu tekst (vaikimisi: tekst tõlgete seadetest)."

msgid "CSS trieda pre vlastné štýlovanie."
msgstr "CSS-klass kohandatud kujunduse jaoks."

msgid "Voliteľné HTML id atribút."
msgstr "Valikuline HTML id atribuut."

msgid "Exportuje všetky nastavenia do JSON súboru. Vhodné pre presun medzi servermi alebo zálohu."
msgstr "Ekspordib kõik seaded JSON-faili. Sobib serverite vahel ülekandmiseks või varundamiseks."

msgid "Nahrajte predtým exportovaný settings.json. Prepisuje aktuálnu konfiguráciu."
msgstr "Laadige üles varem eksporditud settings.json. Kirjutab praeguse konfiguratsiooni üle."

msgid "Kliknite alebo presuňte settings.json sem"
msgstr "Klõpsake või lohistage settings.json siia"

msgid "Resetuje všetky nastavenia na predvolené hodnoty (SK jazyk, predvolený vzhľad). Deklarácie cookies, pravidlá blokovania a záznamy súhlasov nie sú ovplyvnené."
msgstr "Lähtestab kõik seaded vaikeväärtustele (SK keel, vaikimisi välimus). Küpsiste deklaratsioonid, blokeerimisreeglid ja nõusolekute logid ei ole mõjutatud."

msgid "Verzia"
msgstr "Versioon"

msgid "Deklarácie cookies"
msgstr "Küpsiste deklaratsioonid"

msgid "Pravidlá blokovania"
msgstr "Blokeerimisreeglid"

msgid "O plugine Web Pixel Studio Cookie Consent for EU"
msgstr "Pluginist Web Pixel Studio Cookie Consent for EU"

msgid "Popis pluginu"
msgstr "Plugini kirjeldus"

msgid "Hlavné funkcie"
msgstr "Põhifunktsioonid"

msgid "Cookie banner"
msgstr "Küpsistebänner"

msgid "Prispôsobiteľný popup/bar/cloud banner s výberom polohy na stránke."
msgstr "Kohandatav popup/bar/cloud bänner asukoha valikuga lehel."

msgid "Modál preferencií"
msgstr "Eelistuste modaal"

msgid "Používateľ si môže zvoliť, ktoré kategórie cookies povolí (nevyhnutné, analytické, marketingové, preferenčné)."
msgstr "Kasutaja saab valida, millised küpsiste kategooriad lubada (vajalikud, analüütilised, turundus, eelistused)."

msgid "Každý súhlas sa uloží do databázy s ID, IP adresou, URL a časovou pečiatkou. Export do CSV."
msgstr "Iga nõusolek salvestatakse andmebaasi ID, IP-aadressiga, URL-i ja ajatempliga. Eksport CSV-sse."

msgid "Skripty tretích strán (napr. Google Analytics, Meta Pixel) sa zablokujú, kým používateľ neudelí súhlas."
msgstr "Kolmandate osapoolte skriptid (nt Google Analytics, Meta Pixel) blokeeritakse, kuni kasutaja annab nõusoleku."

msgid "Predpripravené sady cookies a skriptov"
msgstr "Eelseadistatud küpsiste ja skriptide komplektid"

msgid "Hotové predvoľby jedným kliknutím doplnia bežné Google a Meta cookies spolu so súvisiacimi pravidlami blokovania."
msgstr "Valmis eelseadistused lisavad ühe klõpsuga tavalised Google'i ja Meta küpsised koos seotud blokeerimisreeglitega."

msgid "Consent Mode v2 / v3"
msgstr "Consent Mode v2 / v3"

msgid "Automaticky nastaví default denied stav a aktualizuje Google signály po udelení súhlasu."
msgstr "Seab automaatselt vaikimisi keelatud oleku ja uuendab Google'i signaale pärast nõusoleku andmist."

msgid "Plné prispôsobenie vzhľadu"
msgstr "Täielik välimuse kohandamine"

msgid "Farby, font, zaoblenie tlačidiel, rozloženie bannera, poloha floating ikony."
msgstr "Värvid, font, nuppude ümarotsad, bänneri paigutus, ujuva ikooni asukoht."

msgid "9 jazykových predvolieb"
msgstr "9 keele eelseadistust"

msgid "SK, EN, CS, DE, FR, ES, PL, HU, IT. Všetky texty sú plne editovateľné z admin panelu."
msgstr "SK, EN, CS, DE, FR, ES, PL, HU, IT. Kõiki tekste saab täielikult redigeerida halduspaneelilt."

msgid "[ccwps_consent_id] – zobrazí ID súhlasu návštevníka. [ccwps_cookie_list] – tabuľka deklarovaných cookies. [ccwps_manage_consent] – tlačidlo na správu súhlasu."
msgstr "[ccwps_consent_id] – kuvab külastaja nõusoleku ID. [ccwps_cookie_list] – deklareeritud küpsiste tabel. [ccwps_manage_consent] – nõusoleku haldamise nupp."

msgid "Export/Import nastavení"
msgstr "Seadete eksport/import"

msgid "Detekcia robotov"
msgstr "Robotite tuvastamine"

msgid "Banner sa automaticky skryje pred vyhľadávačmi a crawlermi."
msgstr "Bänner peidetakse automaatselt otsimootorite ja veebiroomijaite eest."

msgid "Ak sa zmení zoznam cookies, plugin automaticky požiada o nový súhlas."
msgstr "Kui küpsiste loend muutub, küsib plugin automaatselt uut nõusolekut."

msgid "Floating ikona"
msgstr "Ujuv ikoon"

msgid "Plávajúca ikona umožní používateľovi kedykoľvek zmeniť preferencie. Po kliknutí zobrazí ID súhlasu a dátum."
msgstr "Ujuv ikoon võimaldab kasutajal eelistusi igal ajal muuta. Klõpsates kuvatakse nõusoleku ID ja kuupäev."

msgid "Postup nastavenia"
msgstr "Seadistamise protsess"

msgid "V záložke Nastavenia zapnite Zaznamenávať súhlasy, Opätovný súhlas, Skryť pre robotov a Automatické spustenie. Vyberte verziu Consent Mode (v2 pre väčšinu webov). Ak používate GTM, vyplňte GTM Container ID."
msgstr "Vahekaardil Seaded lülitage sisse Nõusolekute logimine, Uuesti nõusolek, Peida robotite eest ja Automaatne käivitamine. Valige Consent Mode versioon (v2 enamiku veebisaitide jaoks). Kui kasutate GTM-i, täitke GTM Container ID."

msgid "V záložke Preklady vyberte jazyk pomocou rýchlych predvolieb alebo upravte texty manuálne. Kliknite Uložiť preklady."
msgstr "Vahekaardil Tõlked valige keel kiireelseadistuste abil või muutke tekste käsitsi. Klõpsake Salvesta tõlked."

msgid "V záložke Vzhľad nastavte farby, rozloženie bannera a polohu plávajúcej ikony. Použite tlačidlá Náhľad na overenie zmien."
msgstr "Vahekaardil Välimus seadistage värvid, bänneri paigutus ja ujuva ikooni asukoht. Kasutage eelvaate nuppe muudatuste kontrollimiseks."

msgid "Deklarácia cookies"
msgstr "Küpsiste deklaratsioon"

msgid "V záložke Cookies pridajte všetky cookies, ktoré váš web používa. Pre každú cookie vyplňte názov, doménu, platnosť, popis a kategóriu. Popis bude viditeľný návštevníkovi."
msgstr "Vahekaardil Küpsised lisage kõik küpsised, mida teie veebisait kasutab. Iga küpsise jaoks täitke nimi, domeen, kehtivus, kirjeldus ja kategooria. Kirjeldus on külastajatele nähtav."

msgid "V záložke Blokovanie skriptov pridajte pravidlá pre skripty, ktoré chcete blokovať. Napr. pre Google Analytics pridajte \"google-analytics.com\" → kategória Analytické."
msgstr "Vahekaardil Skriptide blokeerimine lisage reeglid skriptidele, mida soovite blokeerida. Nt Google Analytics'i jaoks lisage \"google-analytics.com\" → kategooria Analüütilised."

msgid "Cookie politika"
msgstr "Küpsisepoliitika"

msgid "Na stránku s Cookie politikou vložte [ccwps_cookie_list] pre automatickú tabuľku cookies, [ccwps_consent_id] pre zobrazenie ID súhlasu a [ccwps_manage_consent] pre tlačidlo zmeny preferencií."
msgstr "Küpsisepoliitika lehele lisage [ccwps_cookie_list] automaatse küpsiste tabeli jaoks, [ccwps_consent_id] nõusoleku ID kuvamiseks ja [ccwps_manage_consent] eelistuste muutmise nupu jaoks."

msgid "Overenie"
msgstr "Kontrollimine"

msgid "Otvorte web v incognito okne a overte, že sa banner zobrazí, súhlas sa zaznamená v záložke Záznamy súhlasov a floating ikona funguje správne."
msgstr "Avage veebisait inkognito aknas ja kontrollige, et bänner kuvataks, nõusolek logitaks vahekaardil Nõusolekute logi ja ujuv ikoon töötaks korrektselt."

msgid "Nastavenie Google Tag Manager + Consent Mode"
msgstr "Google Tag Manager + Consent Mode seadistamine"

msgid "Možnosť A: Plugin načíta GTM automaticky"
msgstr "Valik A: Plugin laadib GTM-i automaatselt"

msgid "V záložke Nastavenia vyplňte GTM Container ID (napr. GTM-XXXXXXX). Plugin automaticky vloží GTM kód do hlavičky stránky spolu s Consent Mode default stavom (všetky signály = denied). Po udelení súhlasu sa GTM aktualizuje pomocou gtag('consent', 'update', ...)."
msgstr "Vahekaardil Seaded täitke GTM Container ID (nt GTM-XXXXXXX). Plugin lisab automaatselt GTM koodi lehe päisesse koos Consent Mode vaikimisi olekuga (kõik signaalid = denied). Pärast nõusoleku andmist uuendatakse GTM-i gtag('consent', 'update', ...) kaudu."

msgid "Možnosť B: GTM máte nainštalovaný inak (téma, iný plugin)"
msgstr "Valik B: GTM on paigaldatud muul viisil (teema, muu plugin)"

msgid "Nechajte GTM Container ID prázdne. Plugin automaticky vloží Consent Mode default stav pred GTM kód, takže default denied signály sa nastavia skôr, ako GTM spustí akékoľvek tagy. Toto je správne správanie podľa Google dokumentácie."
msgstr "Jätke GTM Container ID tühjaks. Plugin lisab automaatselt Consent Mode vaikimisi oleku enne GTM koodi, nii et vaikimisi keelatud signaalid seatakse enne, kui GTM käivitab ühegi tagi. See on õige käitumine vastavalt Google'i dokumentatsioonile."

msgid "Nastavenie tagov v GTM"
msgstr "Tagide seadistamine GTM-is"

msgid "V GTM nastavte pre každý tag Consent Settings. Pre Google Analytics (GA4): analytics_storage = Required. Pre Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Tagy sa spustia len po udelení príslušného súhlasu."
msgstr "GTM-is seadistage iga tagi jaoks Consent Settings. Google Analytics'i (GA4) jaoks: analytics_storage = Required. Google Adsi jaoks: ad_storage, ad_user_data, ad_personalization = Required. Tagid käivituvad ainult pärast vastava nõusoleku andmist."

msgid "Overenie pomocou Google Tag Assistant"
msgstr "Kontrollimine Google Tag Assistantiga"

msgid "Otvorte Google Tag Assistant a overte, že pri odmietnutí cookies sú tagy v stave \"Consent Blocked\" a po udelení súhlasu sa aktivujú. Skontrolujte tiež Google Analytics Realtime report."
msgstr "Avage Google Tag Assistant ja kontrollige, et küpsistest keeldumisel on tagid olekus \"Consent Blocked\" ja aktiveeritakse pärast nõusoleku andmist. Kontrollige ka Google Analytics'i reaalajas aruannet."

msgid "Autor a podpora"
msgstr "Autor ja tugi"

msgid "Plugin vytvoril Web Pixel Studio. Pre otázky, návrhy alebo hlásenie chýb nás kontaktujte na:"
msgstr "Plugini lõi Web Pixel Studio. Küsimuste, ettepanekute või vigade teatamiseks võtke meiega ühendust:"

msgid "Plugin je bezplatný a open-source pod licenciou GPL-2.0. Postavený na:"
msgstr "Plugin on tasuta ja avatud lähtekoodiga GPL-2.0 litsentsi all. Ehitatud:"

msgid "Použiť font témy"
msgstr "Kasuta teema fonti"

msgid "Nepodarilo sa odoslať žiadosť. Skúste to znova."
msgstr "Päringut ei õnnestunud saata. Proovige uuesti."

msgid "Zadajte platný e-mail."
msgstr "Sisestage kehtiv e-posti aadress."

msgid "Predmet musí mať 3 až 150 znakov."
msgstr "Teema peab olema 3 kuni 150 tähemärki."

msgid "Text správy musí mať 20 až 4000 znakov."
msgstr "Sõnumi tekst peab olema 20 kuni 4000 tähemärki."

msgid "Počkajte prosím 30 sekúnd a skúste to znova."
msgstr "Palun oodake 30 sekundit ja proovige uuesti."

msgid "Dosiahli ste limit 3 žiadostí za 10 minút. Skúste to neskôr."
msgstr "Olete jõudnud 3 päringu limiidini 10 minuti jooksul. Proovige hiljem."

msgid "Denný limit žiadostí bol dosiahnutý. Skúste to zajtra."
msgstr "Päevane päringute limiit on täis. Proovige homme."

msgid "Žiadosť sa nepodarilo odoslať z tohto WordPress webu. Skontrolujte SMTP/mail konfiguráciu hostingu."
msgstr "Päringut ei õnnestunud sellelt WordPress'i saidilt saata. Kontrollige hosting'u SMTP/posti konfiguratsiooni."

msgid "Detail chyby: %s"
msgstr "Veateave: %s"

msgid "Žiadosť bola úspešne odoslaná."
msgstr "Päring saadeti edukalt."

msgid "Cookie settings"
msgstr "Küpsiste seaded"

msgid "Súhlas nebol udelený."
msgstr "Nõusolekut ei antud."

msgid "Žiadne cookies nie sú deklarované."
msgstr "Küpsiseid pole deklareeritud."
