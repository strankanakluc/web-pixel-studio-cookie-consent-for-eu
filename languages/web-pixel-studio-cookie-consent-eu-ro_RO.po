msgstr "Despre plugin"

msgid "Jazyk:"
msgstr "Limbă:"

msgid "Náhľad:"
msgstr "Previzualizare:"

msgid "Zobraziť banner"
msgstr "Afișează banner"

msgid "Nastavenia cookies"
msgstr "Setări cookie-uri"

msgid "Funguje na základe"
msgstr "Funcționează pe baza"

msgid "Bezplatný plugin vytvoril:"
msgstr "Plugin gratuit creat de:"

msgid "Automatické spustenie"
msgstr "Pornire automată"

msgid "Banner sa zobrazí automaticky pri načítaní stránky."
msgstr "Bannerul va apărea automat la încărcarea paginii."

msgid "💡 Odporúčame zapnúť. Vypnuté = zobraziť manuálne cez <code>CookieConsentWPS.showBanner()</code>"
msgstr "💡 Recomandăm să activați. Dezactivat = afișați manual prin <code>CookieConsentWPS.showBanner()</code>"

msgid "Vynútený súhlas"
msgstr "Consimțământ obligatoriu"

msgid "Používateľ nemôže prehliadať web bez udelenia súhlasu."
msgstr "Utilizatorul nu poate naviga pe site fără a acorda consimțământul."

msgid "⚠️ GDPR neukladá povinnosť vynútiť súhlas. Odporúčame VYPNÚŤ – používateľ má právo odmietnuť."
msgstr "⚠️ RGPD nu impune obligația de a forța consimțământul. Recomandăm DEZACTIVAREA – utilizatorul are dreptul de a refuza."

msgid "Automatické vymazanie cookies"
msgstr "Ștergere automată a cookie-urilor"

msgid "Pri odvolaní súhlasu sa automaticky vymažú cookies danej kategórie."
msgstr "La retragerea consimțământului, cookie-urile din acea categorie vor fi șterse automat."

msgid "💡 Funguje len pre cookies deklarované v záložke Cookies. Odporúčame zapnúť."
msgstr "💡 Funcționează doar pentru cookie-urile declarate în fila Cookie-uri. Recomandăm să activați."

msgid "Správa skriptov na stránke"
msgstr "Gestionarea scripturilor pe pagină"

msgid "Blokuje skripty tretích strán, kým používateľ neudelí súhlas."
msgstr "Blochează scripturile terților până când utilizatorul acordă consimțământul."

msgid "💡 Definujte pravidlá v záložke \"Blokovanie skriptov\". Plugin zmení typ skriptu na text/plain."
msgstr "💡 Definiți regulile în fila \"Blocare scripturi\". Pluginul va schimba tipul scriptului în text/plain."

msgid "Skryť pre robotov"
msgstr "Ascunde pentru roboți"

msgid "Banner sa nezobrazí vyhľadávačom a crawlerom."
msgstr "Bannerul nu va apărea motoarelor de căutare și crawlerelor."

msgid "💡 Odporúčame zapnúť. Zlepšuje SEO skóre webu."
msgstr "💡 Recomandăm să activați. Îmbunătățește scorul SEO al site-ului."

msgid "Opätovný súhlas"
msgstr "Consimțământ reînnoit"

msgid "Zobrazí banner znova, keď sa zmení zoznam cookies."
msgstr "Afișează din nou bannerul când se modifică lista de cookie-uri."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje nový súhlas po zmene účelu spracovania."
msgstr "💡 Recomandăm să activați – RGPD impune un nou consimțământ după modificarea scopului prelucrării."

msgid "Zaznamenávať súhlasy"
msgstr "Înregistrează consimțăminte"

msgid "Každý súhlas sa uloží do databázy (ID, IP, URL, čas)."
msgstr "Fiecare consimțământ este salvat în baza de date (ID, IP, URL, timp)."

msgid "💡 Odporúčame zapnúť – záznamy slúžia ako dôkaz súhlasu pre GDPR audit."
msgstr "💡 Recomandăm să activați – înregistrările servesc ca dovadă a consimțământului pentru auditul RGPD."

msgid "Jazyk podľa návštevníka"
msgstr "Limbă în funcție de vizitator"

msgid "Frontend cookie lišta sa pokúsi načítať jazyk návštevníka a zobraziť zodpovedajúci dostupný preklad."
msgstr "Bara de cookie-uri frontend va încerca să detecteze limba vizitatorului și să afișeze traducerea disponibilă corespunzătoare."

msgid "💡 Ak jazyk návštevníka nie je dostupný, plugin použije English (GB). Ak je voľba vypnutá, frontend používa aktuálne uložené texty bannera."
msgstr "💡 Dacă limba vizitatorului nu este disponibilă, pluginul va folosi English (GB). Dacă opțiunea este dezactivată, frontend-ul folosește textele bannerului salvate curent."

msgid "Skryť prázdne kategórie"
msgstr "Ascunde categoriile goale"

msgid "V modáli preferencií sa skryjú kategórie bez deklarovaných cookies."
msgstr "În modalul de preferințe se vor ascunde categoriile fără cookie-uri declarate."

msgid "💡 Zapnite, keď máte vyplnené všetky kategórie v záložke Cookies."
msgstr "💡 Activați când ați completat toate categoriile în fila Cookie-uri."

msgid "Oneskorenie zobrazenia (ms)"
msgstr "Întârziere afișare (ms)"

msgid "Čas v milisekundách pred zobrazením bannera."
msgstr "Timp în milisecunde înainte de afișarea bannerului."

msgid "💡 Hodnota 0 = okamžite. Odporúčame 0–500 ms. Vyššie hodnoty môžu byť problém pri GDPR auditoch."
msgstr "💡 Valoarea 0 = imediat. Recomandăm 0–500 ms. Valorile mai mari pot fi o problemă la auditurile RGPD."

msgid "Platnosť súhlasu (dni)"
msgstr "Valabilitate consimțământ (zile)"

msgid "Po koľkých dňoch vyprší súhlas a banner sa zobrazí znova."
msgstr "Numărul de zile după care expiră consimțământul și bannerul apare din nou."

msgid "💡 GDPR odporúča max. 13 mesiacov (390 dní). Predvolených 182 dní (6 mes.) je bezpečná hodnota."
msgstr "💡 RGPD recomandă max. 13 luni (390 de zile). Valoarea implicită de 182 de zile (6 luni) este o valoare sigură."

msgid "Cesta cookie"
msgstr "Cale cookie"

msgid "Cesta, na ktorej bude cookie platná."
msgstr "Calea pe care cookie-ul va fi valid."

msgid "💡 Nechajte \"/\" – cookie bude platná na celom webe."
msgstr "💡 Lăsați \"/\" – cookie-ul va fi valid pe întregul site."

msgid "Doména cookie"
msgstr "Domeniu cookie"

msgid "Nechajte prázdne pre automatickú detekciu."
msgstr "Lăsați gol pentru detectare automată."

msgid "💡 Vyplňte \".mojeweb.sk\" (s bodkou) ak chcete zdieľať súhlas medzi subdoménami."
msgstr "💡 Completați \".sitemeu.ro\" (cu punct) dacă doriți să partajați consimțământul între subdomenii."

msgid "Google Consent Mode"
msgstr "Google Consent Mode"

msgid "Čo je Consent Mode?"
msgstr "Ce este Consent Mode?"

msgid " Google Consent Mode umožňuje Googlu modelovať chýbajúce dáta, keď používatelia odmietnu analytické/reklamné cookies. Vaše kampane budú stále merateľné aj bez plného súhlasu."
msgstr " Google Consent Mode permite Google să modeleze datele lipsă atunci când utilizatorii refuză cookie-urile analitice/publicitare. Campaniile dvs. vor rămâne măsurabile chiar și fără consimțământul complet."

msgid "Verzia Consent Mode"
msgstr "Versiune Consent Mode"

msgid "Vypnuté"
msgstr "Dezactivat"

msgid "Consent Mode sa nepoužíva. Vhodné ak nepoužívate Google Analytics ani Ads."
msgstr "Consent Mode nu este utilizat. Potrivit dacă nu folosiți Google Analytics sau Ads."

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Štandard od marca 2024. Vyžadovaný pre Google Ads a GA4 v EÚ. Posiela signály ad_user_data a ad_personalization. Nutné pre remarketing a konverzie."
msgstr "Standard din martie 2024. Necesar pentru Google Ads și GA4 în UE. Trimite semnale ad_user_data și ad_personalization. Necesar pentru remarketing și conversii."

msgid "Consent Mode v3"
msgstr "Consent Mode v3"

msgid "Rozšírenie v2 o developer ID signál. Zahŕňa všetky funkcie v2 + nastavenie developer_id pre presnejšie modelovanie konverzií. Vhodné pre pokročilé Google Marketing Platform funkcie."
msgstr "Extensie a v2 cu semnal developer ID. Include toate funcțiile v2 + setarea developer_id pentru modelarea mai precisă a conversiilor. Potrivit pentru funcții avansate ale Google Marketing Platform."

msgid "Odporúčané"
msgstr "Recomandat"

msgid "Nové"
msgstr "Nou"

msgid "💡 Pre väčšinu webov stačí v2. v3 použite ak využívate pokročilé Google Marketing Platform funkcie. Obe verzie vyžadujú GTM alebo manuálne načítanie gtag.js."
msgstr "💡 Pentru majoritatea site-urilor, v2 este suficient. Folosiți v3 dacă utilizați funcții avansate ale Google Marketing Platform. Ambele versiuni necesită GTM sau încărcarea manuală a gtag.js."

msgid "GTM Container ID"
msgstr "GTM Container ID"

msgid "Voliteľné: Plugin načíta GTM automaticky."
msgstr "Opțional: Pluginul va încărca GTM automat."

msgid "💡 Vyplňte len ak GTM nenačítavate iným spôsobom. Ak GTM máte v téme alebo inom plugine, nechajte prázdne."
msgstr "💡 Completați doar dacă nu încărcați GTM în alt mod. Dacă GTM este în temă sau alt plugin, lăsați gol."

msgid "Typ bannera"
msgstr "Tip banner"

msgid "💡 Box – kompaktný popup v rohu. Bar – horizontálny pruh cez celú šírku. Cloud – zaoblený popup s väčším tieňom."
msgstr "💡 Box – popup compact în colț. Bar – bară orizontală pe toată lățimea. Cloud – popup rotunjit cu umbră mai mare."

msgid "Poloha bannera"
msgstr "Poziție banner"

msgid "Dole vľavo"
msgstr "Jos stânga"

msgid "Dole vpravo"
msgstr "Jos dreapta"

msgid "Dole v strede"
msgstr "Jos centru"

msgid "Hore vľavo"
msgstr "Sus stânga"

msgid "Hore vpravo"
msgstr "Sus dreapta"

msgid "Hore v strede"
msgstr "Sus centru"

msgid "Stred obrazovky"
msgstr "Centrul ecranului"

msgid "Zobraziť plávajúcu ikonu"
msgstr "Afișează icoana flotantă"

msgid "Po udelení súhlasu sa zobrazí ikona na opätovnú správu preferencií."
msgstr "După acordarea consimțământului, va apărea o icoană pentru gestionarea din nou a preferințelor."

msgid "💡 Odporúčame zapnúť – GDPR vyžaduje, aby mohol používateľ kedykoľvek odvolať súhlas. Po kliknutí na ikonu sa zobrazí panel s ID súhlasu a tlačidlami."
msgstr "💡 Recomandăm să activați – RGPD impune ca utilizatorul să poată retrage consimțământul oricând. La clic pe icoană, apare un panou cu ID-ul consimțământului și butoanele."

msgid "Poloha ikony"
msgstr "Poziție icoană"

msgid "Vertikálny margin ikony (px)"
msgstr "Margine verticală icoană (px)"

msgid "Posunie ikonu vyššie alebo nižšie od základnej polohy podľa vybraného rohu."
msgstr "Mută icoana mai sus sau mai jos față de poziția de bază, în funcție de colțul selectat."

msgid "💡 Pri dolnej polohe vyššia hodnota zdvihne ikonu hore. Pri hornej polohe vyššia hodnota ju posunie nižšie."
msgstr "💡 La poziția de jos, o valoare mai mare ridică icoana. La poziția de sus, o valoare mai mare o coboară."

msgid "Vertikálny margin ikony na mobile (px)"
msgstr "Margine verticală icoană pe mobil (px)"

msgid "Platí iba pre mobilné zariadenia (šírka do 520 px)."
msgstr "Se aplică doar pentru dispozitive mobile (lățime până la 520 px)."

msgid "💡 Použite, ak chcete mať na mobile inú výšku ikony než na desktope."
msgstr "💡 Folosiți dacă doriți o înălțime diferită a icoanii pe mobil față de desktop."

msgid "Typ ikony"
msgstr "Tip icoană"

msgid "🖼 Vlastná ikona (obrázok)"
msgstr "🖼 Icoană personalizată (imagine)"

msgid "Vlastná ikona"
msgstr "Icoană personalizată"

msgid "Žiadny obrázok"
msgstr "Fără imagine"

msgid "📂 Vybrať / nahrať obrázok"
msgstr "📂 Selectează / încarcă imagine"

msgid "Odstrániť"
msgstr "Elimină"

msgid "Pozadie floating ikony"
msgstr "Fundal icoană flotantă"

msgid "Farba kruhu floating ikony."
msgstr "Culoarea cercului icoanii flotante."

msgid "Pozadie floating ikony (hover)"
msgstr "Fundal icoană flotantă (hover)"

msgid "Farba kruhu floating ikony po prejdení myšou."
msgstr "Culoarea cercului icoanii flotante la trecerea mouse-ului."

msgid "Farba obsahu floating ikony"
msgstr "Culoarea conținutului icoanii flotante"

msgid "Farba SVG ikony alebo obsahu vo floating ikone."
msgstr "Culoarea icoanii SVG sau a conținutului din icoana flotantă."

msgid "Pozadie popupu floating ikony"
msgstr "Fundal popup icoană flotantă"

msgid "Farba pozadia popupu po kliknutí na floating ikonu."
msgstr "Culoarea de fundal a popup-ului la clic pe icoana flotantă."

msgid "Farba textu popupu floating ikony"
msgstr "Culoarea textului popup icoană flotantă"

msgid "Farba textu a obsahu popupu po kliknutí na floating ikonu."
msgstr "Culoarea textului și conținutului popup-ului la clic pe icoana flotantă."

msgid "Zobraziť logo v banneri"
msgstr "Afișează logo în banner"

msgid "V pravom hornom rohu cookie lišty sa zobrazí vaše logo."
msgstr "Logo-ul dvs. va apărea în colțul din dreapta sus al barei de cookie-uri."

msgid "Logo bannera"
msgstr "Logo banner"

msgid "Šírka loga (px)"
msgstr "Lățime logo (px)"

msgid "💡 Šírka loga v pixeloch (20–100 px). Výška sa prispôsobí automaticky."
msgstr "💡 Lățimea logo-ului în pixeli (20–100 px). Înălțimea se va ajusta automat."

msgid "Font"
msgstr "Font"

msgid "CSS font-family hodnota"
msgstr "Valoare CSS font-family"

msgid "Pole ponúka iba detegované fonty z témy, theme.json, Elementora a frontend CSS."
msgstr "Câmpul oferă doar fonturile detectate din temă, theme.json, Elementor și CSS-ul frontend."

msgid "💡 V zozname sa zobrazuje iba názov fontu. Po výbere sa uloží kompletná font-family hodnota detegovaná na stránke. Voľba \"Použiť font témy\" zodpovedá hodnote inherit."
msgstr "💡 În listă se afișează doar numele fontului. După selectare, se va salva valoarea completă font-family detectată pe pagină. Opțiunea \"Folosiți fontul temei\" corespunde valorii inherit."

msgid "Zaoblenie tlačidiel (px)"
msgstr "Rotunjire butoane (px)"

msgid "💡 0 = hranaté, 8 = mierne zaoblené, 24+ = \"pill\" tvar."
msgstr "💡 0 = colțuros, 8 = ușor rotunjit, 24+ = formă \"pill\"."

msgid "Zaoblenie bannera / modálu (px)"
msgstr "Rotunjire banner / modal (px)"

msgid "💡 Zaoblenie rohov bannera aj modálu. Predvolené: 12 px."
msgstr "💡 Rotunjirea colțurilor bannerului și modalului. Implicit: 12 px."

msgid "Farby bannera"
msgstr "Culori banner"

msgid "Nastavte farby pre pozadie a text cookie lišty (bannera)."
msgstr "Setați culorile pentru fundalul și textul barei de cookie-uri (banner)."

msgid "Pozadie bannera"
msgstr "Fundal banner"

msgid "Farba pozadia cookie lišty."
msgstr "Culoarea de fundal a barei de cookie-uri."

msgid "Farba nadpisu bannera"
msgstr "Culoarea titlului bannerului"

msgid "Farba hlavného nadpisu v banneri."
msgstr "Culoarea titlului principal din banner."

msgid "Farba textu bannera"
msgstr "Culoarea textului bannerului"

msgid "Farba popisu a bežného textu v banneri."
msgstr "Culoarea descrierii și textului obișnuit din banner."

msgid "Primárna / akcentová farba"
msgstr "Culoare primară / accent"

msgid "Používa sa ako fallback farba pre tlačidlá a zvýraznenia."
msgstr "Folosită ca culoare de rezervă pentru butoane și evidențieri."

msgid "Priesvitnosť bannera Cloud (%)"
msgstr "Opacitate banner Cloud (%)"

msgid "Platí iba pre typ bannera Cloud. 0 = maximálne priehľadný, 100 = najmenej priehľadný."
msgstr "Se aplică doar pentru tipul de banner Cloud. 0 = maxim transparent, 100 = minim transparent."

msgid "Tlačidlo \"Prijať všetky\" (primárne)"
msgstr "Buton \"Acceptă tot\" (primar)"

msgid "Farebné nastavenia pre hlavné modré tlačidlo súhlasu. Prázdne pole = použije sa primárna farba."
msgstr "Setări de culoare pentru butonul principal de consimțământ. Câmp gol = se aplică culoarea primară."

msgid "Pozadie"
msgstr "Fundal"

msgid "Pozadie (hover)"
msgstr "Fundal (hover)"

msgid "Farba textu"
msgstr "Culoarea textului"

msgid "Farba textu (hover)"
msgstr "Culoarea textului (hover)"

msgid "Tlačidlo \"Odmietnuť všetky\" (primárne)"
msgstr "Buton \"Refuză tot\" (primar)"

msgid "Farebné nastavenia pre tlačidlo odmietnutia. Možnosti sú zjednotené s tlačidlom \"Prijať všetky\"."
msgstr "Setări de culoare pentru butonul de refuz. Opțiunile sunt unificate cu butonul \"Acceptă tot\"."

msgid "Tlačidlo \"Spravovať nastavenia\" (outline)"
msgstr "Buton \"Gestionează setările\" (outline)"

msgid "Farebné nastavenia pre tlačidlo správy preferencií."
msgstr "Setări de culoare pentru butonul de gestionare a preferințelor."

msgid "Farba ohraničenia"
msgstr "Culoarea chenarului"

msgid "Priehľadné"
msgstr "Transparent"

msgid "Okno modálu (Spravovať súhlas)"
msgstr "Fereastra modală (Gestionează consimțământul)"

msgid "Farby pre okno nastavenia cookies, ktoré sa otvorí po kliknutí na \"Spravovať nastavenia\"."
msgstr "Culori pentru fereastra de setări cookie-uri care se deschide la clic pe \"Gestionează setările\"."

msgid "Pozadie modálu"
msgstr "Fundal modal"

msgid "Farba identifikátora súhlasu"
msgstr "Culoarea identificatorului de consimțământ"

msgid "Pozadie hlavičky"
msgstr "Fundal antet"

msgid "Pozadie päty"
msgstr "Fundal subsol"

msgid "Farba ohraničení"
msgstr "Culoarea chenarelor"

msgid "Pozadie kategórie"
msgstr "Fundal categorie"

msgid "Pozadie kategórie (hover)"
msgstr "Fundal categorie (hover)"

msgid "Farba prepínača (zapnutý)"
msgstr "Culoarea comutatorului (activat)"

msgid "Farba textu \"Vždy aktívne\""
msgstr "Culoarea textului \"Întotdeauna activ\""

msgid "Zaoblenie modálu (px)"
msgstr "Rotunjire modal (px)"

msgid "Banner"
msgstr "Banner"

msgid "Kliknite na jazyk – všetky polia sa vyplnia automaticky. Potom kliknite Uložiť."
msgstr "Faceți clic pe o limbă – toate câmpurile se vor completa automat. Apoi faceți clic pe Salvare."

msgid "Popis cookie je viditeľný návštevníkom v modáli preferencií – pomáha im pochopiť, na čo daná cookie slúži."
msgstr "Descrierea cookie-ului este vizibilă vizitatorilor în modalul de preferințe – îi ajută să înțeleagă pentru ce servește acel cookie."

msgid "viditeľný návštevníkom"
msgstr "vizibil vizitatorilor"

msgid "Regex"
msgstr "Regex"

msgid "Žiadne cookies. Kliknite \"+ Pridať cookie\"."
msgstr "Fără cookie-uri. Faceți clic pe \"+ Adaugă cookie\"."

msgid "Cesta"
msgstr "Cale"

msgid "Viditeľný návštevníkom v modáli preferencií."
msgstr "Vizibil vizitatorilor în modalul de preferințe."

msgid "napr. Používa sa Google Analytics na rozlíšenie návštevníkov."
msgstr "ex. Google Analytics îl folosește pentru a distinge vizitatorii."

msgid "Kategória"
msgstr "Categorie"

msgid "Je Regex?"
msgstr "Este Regex?"

msgid "Email"
msgstr "E-mail"

msgid "Predmet"
msgstr "Subiect"

msgid "Text"
msgstr "Text"

msgid "Náhľad zoznamu cookies"
msgstr "Previzualizare listă cookie-uri"

msgid "Definujte zdroje skriptov, ktoré sa majú blokovať, kým používateľ neudelí súhlas pre danú kategóriu. Plugin zmení typ skriptu na text/plain, čo zabrání jeho spusteniu."
msgstr "Definiți sursele scripturilor care trebuie blocate până când utilizatorul acordă consimțământul pentru acea categorie. Pluginul va schimba tipul scriptului în text/plain, împiedicând rularea acestuia."

msgid "Žiadne pravidlá blokovania."
msgstr "Fără reguli de blocare."

msgid "Zdroj skriptu"
msgstr "Sursă script"

msgid "Fragment URL, napr. \"google-analytics.com\""
msgstr "Fragment URL, ex. \"google-analytics.com\""

msgid "Nev."
msgstr "Nec."

msgid "Anal."
msgstr "Ana."

msgid "Market."
msgstr "Mkt."

msgid "Pref."
msgstr "Pref."

msgid "ID súhlasu návštevníka"
msgstr "ID consimțământ vizitator"

msgid "Zobrazí jedinečné ID súhlasu aktuálneho návštevníka. Vhodné pre zásady ochrany osobných údajov – umožní používateľovi preukázať, kedy a ako súhlasil."
msgstr "Afișează ID-ul unic de consimțământ al vizitatorului curent. Potrivit pentru politicile de confidențialitate – permite utilizatorului să dovedească când și cum a consimțit."

msgid "Parameter"
msgstr "Parametru"

msgid "Predvolené"
msgstr "Implicit"

msgid "Text pred ID."
msgstr "Text înainte de ID."

msgid "HTML obal (p, div, span…)"
msgstr "Container HTML (p, div, span…)"

msgid "Zoznam cookies používaných na webe"
msgstr "Lista cookie-urilor folosite pe site"

msgid "Automaticky zobrazí prehľadnú tabuľku všetkých deklarovaných cookies, rozdelenú podľa kategórií. Vložte na stránku s cookie politikou."
msgstr "Afișează automat un tabel clar cu toate cookie-urile declarate, împărțit pe categorii. Inserați pe pagina de politică de cookie-uri."

msgid "Filtruj: necessary, analytics, targeting, preferences"
msgstr "Filtrați: necessary, analytics, targeting, preferences"

msgid "Tlačidlo správy súhlasu"
msgstr "Buton gestionare consimțământ"

msgid "Vloží tlačidlo, ktoré otvorí modál nastavenia cookies. Vhodné pre stránky so zásadami ochrany osobných údajov a právne dokumenty – umožní návštevníkovi kedykoľvek zmeniť preferencie."
msgstr "Inserează un buton care deschide modalul de setări cookie-uri. Potrivit pentru paginile de politică de confidențialitate și documente legale – permite vizitatorului să schimbe preferințele oricând."

msgid "Text tlačidla (predvolene: text z nastavení Prekladov)."
msgstr "Textul butonului (implicit: text din setările Traducerilor)."

msgid "CSS trieda pre vlastné štýlovanie."
msgstr "Clasă CSS pentru stilizare personalizată."

msgid "Voliteľné HTML id atribút."
msgstr "Atribut HTML id opțional."

msgid "Exportuje všetky nastavenia do JSON súboru. Vhodné pre presun medzi servermi alebo zálohu."
msgstr "Exportă toate setările într-un fișier JSON. Potrivit pentru transfer între servere sau backup."

msgid "Nahrajte predtým exportovaný settings.json. Prepisuje aktuálnu konfiguráciu."
msgstr "Încărcați un settings.json exportat anterior. Suprascrie configurația actuală."

msgid "Kliknite alebo presuňte settings.json sem"
msgstr "Faceți clic sau trageți settings.json aici"

msgid "Resetuje všetky nastavenia na predvolené hodnoty (SK jazyk, predvolený vzhľad). Deklarácie cookies, pravidlá blokovania a záznamy súhlasov nie sú ovplyvnené."
msgstr "Resetează toate setările la valorile implicite (limbă SK, aspect implicit). Declarațiile de cookie-uri, regulile de blocare și jurnalele de consimțământ nu sunt afectate."

msgid "Verzia"
msgstr "Versiune"

msgid "Deklarácie cookies"
msgstr "Declarații cookie-uri"

msgid "Pravidlá blokovania"
msgstr "Reguli de blocare"

msgid "O plugine Web Pixel Studio Cookie Consent for EU"
msgstr "Despre pluginul Web Pixel Studio Cookie Consent for EU"

msgid "Popis pluginu"
msgstr "Descrierea pluginului"

msgid "Hlavné funkcie"
msgstr "Funcții principale"

msgid "Cookie banner"
msgstr "Banner cookie-uri"

msgid "Prispôsobiteľný popup/bar/cloud banner s výberom polohy na stránke."
msgstr "Banner popup/bar/cloud personalizabil cu selecția poziției pe pagină."

msgid "Modál preferencií"
msgstr "Modal de preferințe"

msgid "Používateľ si môže zvoliť, ktoré kategórie cookies povolí (nevyhnutné, analytické, marketingové, preferenčné)."
msgstr "Utilizatorul poate alege ce categorii de cookie-uri să permită (necesare, analitice, marketing, preferințe)."

msgid "Každý súhlas sa uloží do databázy s ID, IP adresou, URL a časovou pečiatkou. Export do CSV."
msgstr "Fiecare consimțământ este salvat în baza de date cu ID, adresă IP, URL și marcă de timp. Export în CSV."

msgid "Skripty tretích strán (napr. Google Analytics, Meta Pixel) sa zablokujú, kým používateľ neudelí súhlas."
msgstr "Scripturile terților (ex. Google Analytics, Meta Pixel) vor fi blocate până când utilizatorul acordă consimțământul."

msgid "Predpripravené sady cookies a skriptov"
msgstr "Seturi predefinite de cookie-uri și scripturi"

msgid "Hotové predvoľby jedným kliknutím doplnia bežné Google a Meta cookies spolu so súvisiacimi pravidlami blokovania."
msgstr "Setările prestabilite gata de utilizat adaugă cu un clic cookie-urile obișnuite Google și Meta împreună cu regulile de blocare aferente."

msgid "Consent Mode v2 / v3"
msgstr "Consent Mode v2 / v3"

msgid "Automaticky nastaví default denied stav a aktualizuje Google signály po udelení súhlasu."
msgstr "Setează automat starea de refuz implicit și actualizează semnalele Google după acordarea consimțământului."

msgid "Plné prispôsobenie vzhľadu"
msgstr "Personalizare completă a aspectului"

msgid "Farby, font, zaoblenie tlačidiel, rozloženie bannera, poloha floating ikony."
msgstr "Culori, font, rotunjire butoane, aspect banner, poziția icoanii flotante."

msgid "9 jazykových predvolieb"
msgstr "9 setări prestabilite de limbă"

msgid "SK, EN, CS, DE, FR, ES, PL, HU, IT. Všetky texty sú plne editovateľné z admin panelu."
msgstr "SK, EN, CS, DE, FR, ES, PL, HU, IT. Toate textele sunt complet editabile din panoul de administrare."

msgid "[ccwps_consent_id] – zobrazí ID súhlasu návštevníka. [ccwps_cookie_list] – tabuľka deklarovaných cookies. [ccwps_manage_consent] – tlačidlo na správu súhlasu."
msgstr "[ccwps_consent_id] – afișează ID-ul de consimțământ al vizitatorului. [ccwps_cookie_list] – tabel de cookie-uri declarate. [ccwps_manage_consent] – buton de gestionare a consimțământului."

msgid "Export/Import nastavení"
msgstr "Export/Import setări"

msgid "Detekcia robotov"
msgstr "Detectare roboți"

msgid "Banner sa automaticky skryje pred vyhľadávačmi a crawlermi."
msgstr "Bannerul se va ascunde automat față de motoarele de căutare și crawlere."

msgid "Ak sa zmení zoznam cookies, plugin automaticky požiada o nový súhlas."
msgstr "Dacă lista de cookie-uri se modifică, pluginul va solicita automat un nou consimțământ."

msgid "Floating ikona"
msgstr "Icoană flotantă"

msgid "Plávajúca ikona umožní používateľovi kedykoľvek zmeniť preferencie. Po kliknutí zobrazí ID súhlasu a dátum."
msgstr "Icoana flotantă permite utilizatorului să schimbe preferințele oricând. La clic, afișează ID-ul consimțământului și data."

msgid "Postup nastavenia"
msgstr "Procedura de configurare"

msgid "V záložke Nastavenia zapnite Zaznamenávať súhlasy, Opätovný súhlas, Skryť pre robotov a Automatické spustenie. Vyberte verziu Consent Mode (v2 pre väčšinu webov). Ak používate GTM, vyplňte GTM Container ID."
msgstr "În fila Setări, activați Înregistrează consimțăminte, Consimțământ reînnoit, Ascunde pentru roboți și Pornire automată. Selectați versiunea Consent Mode (v2 pentru majoritatea site-urilor). Dacă folosiți GTM, completați GTM Container ID."

msgid "V záložke Preklady vyberte jazyk pomocou rýchlych predvolieb alebo upravte texty manuálne. Kliknite Uložiť preklady."
msgstr "În fila Traduceri, selectați limba folosind setările prestabilite rapide sau editați textele manual. Faceți clic pe Salvează traduceri."

msgid "V záložke Vzhľad nastavte farby, rozloženie bannera a polohu plávajúcej ikony. Použite tlačidlá Náhľad na overenie zmien."
msgstr "În fila Aspect, setați culorile, aspectul bannerului și poziția icoanii flotante. Folosiți butoanele Previzualizare pentru a verifica modificările."

msgid "Deklarácia cookies"
msgstr "Declarație cookie-uri"

msgid "V záložke Cookies pridajte všetky cookies, ktoré váš web používa. Pre každú cookie vyplňte názov, doménu, platnosť, popis a kategóriu. Popis bude viditeľný návštevníkovi."
msgstr "În fila Cookie-uri, adăugați toate cookie-urile pe care le folosește site-ul dvs. Pentru fiecare cookie, completați numele, domeniul, valabilitatea, descrierea și categoria. Descrierea va fi vizibilă vizitatorilor."

msgid "V záložke Blokovanie skriptov pridajte pravidlá pre skripty, ktoré chcete blokovať. Napr. pre Google Analytics pridajte \"google-analytics.com\" → kategória Analytické."
msgstr "În fila Blocare scripturi, adăugați regulile pentru scripturile pe care doriți să le blocați. Ex. pentru Google Analytics, adăugați \"google-analytics.com\" → categoria Analitice."

msgid "Cookie politika"
msgstr "Politică cookie-uri"

msgid "Na stránku s Cookie politikou vložte [ccwps_cookie_list] pre automatickú tabuľku cookies, [ccwps_consent_id] pre zobrazenie ID súhlasu a [ccwps_manage_consent] pre tlačidlo zmeny preferencií."
msgstr "Pe pagina de Politică cookie-uri, inserați [ccwps_cookie_list] pentru tabelul automat de cookie-uri, [ccwps_consent_id] pentru afișarea ID-ului de consimțământ și [ccwps_manage_consent] pentru butonul de schimbare a preferințelor."

msgid "Overenie"
msgstr "Verificare"

msgid "Otvorte web v incognito okne a overte, že sa banner zobrazí, súhlas sa zaznamená v záložke Záznamy súhlasov a floating ikona funguje správne."
msgstr "Deschideți site-ul într-o fereastră incognito și verificați că bannerul apare, consimțământul este înregistrat în fila Jurnale de consimțământ și icoana flotantă funcționează corect."

msgid "Nastavenie Google Tag Manager + Consent Mode"
msgstr "Configurare Google Tag Manager + Consent Mode"

msgid "Možnosť A: Plugin načíta GTM automaticky"
msgstr "Opțiunea A: Pluginul încarcă GTM automat"

msgid "V záložke Nastavenia vyplňte GTM Container ID (napr. GTM-XXXXXXX). Plugin automaticky vloží GTM kód do hlavičky stránky spolu s Consent Mode default stavom (všetky signály = denied). Po udelení súhlasu sa GTM aktualizuje pomocou gtag('consent', 'update', ...)."
msgstr "În fila Setări, completați GTM Container ID (ex. GTM-XXXXXXX). Pluginul va insera automat codul GTM în antetul paginii împreună cu starea implicită Consent Mode (toate semnalele = denied). După acordarea consimțământului, GTM se actualizează prin gtag('consent', 'update', ...)."

msgid "Možnosť B: GTM máte nainštalovaný inak (téma, iný plugin)"
msgstr "Opțiunea B: GTM este instalat altfel (temă, alt plugin)"

msgid "Nechajte GTM Container ID prázdne. Plugin automaticky vloží Consent Mode default stav pred GTM kód, takže default denied signály sa nastavia skôr, ako GTM spustí akékoľvek tagy. Toto je správne správanie podľa Google dokumentácie."
msgstr "Lăsați GTM Container ID gol. Pluginul va insera automat starea implicită Consent Mode înaintea codului GTM, astfel încât semnalele de refuz implicit să fie setate înainte ca GTM să activeze orice etichete. Acesta este comportamentul corect conform documentației Google."

msgid "Nastavenie tagov v GTM"
msgstr "Configurare etichete în GTM"

msgid "V GTM nastavte pre každý tag Consent Settings. Pre Google Analytics (GA4): analytics_storage = Required. Pre Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Tagy sa spustia len po udelení príslušného súhlasu."
msgstr "În GTM, configurați Consent Settings pentru fiecare etichetă. Pentru Google Analytics (GA4): analytics_storage = Required. Pentru Google Ads: ad_storage, ad_user_data, ad_personalization = Required. Etichetele se vor activa doar după acordarea consimțământului corespunzător."

msgid "Overenie pomocou Google Tag Assistant"
msgstr "Verificare cu Google Tag Assistant"

msgid "Otvorte Google Tag Assistant a overte, že pri odmietnutí cookies sú tagy v stave \"Consent Blocked\" a po udelení súhlasu sa aktivujú. Skontrolujte tiež Google Analytics Realtime report."
msgstr "Deschideți Google Tag Assistant și verificați că la refuzul cookie-urilor, etichetele sunt în starea \"Consent Blocked\" și se activează după acordarea consimțământului. Verificați și raportul în timp real Google Analytics."

msgid "Autor a podpora"
msgstr "Autor și suport"

msgid "Plugin vytvoril Web Pixel Studio. Pre otázky, návrhy alebo hlásenie chýb nás kontaktujte na:"
msgstr "Pluginul a fost creat de Web Pixel Studio. Pentru întrebări, sugestii sau raportare erori, contactați-ne la:"

msgid "Plugin je bezplatný a open-source pod licenciou GPL-2.0. Postavený na:"
msgstr "Pluginul este gratuit și open-source sub licența GPL-2.0. Construit pe:"

msgid "Použiť font témy"
msgstr "Folosiți fontul temei"

msgid "Nepodarilo sa odoslať žiadosť. Skúste to znova."
msgstr "Cererea nu a putut fi trimisă. Încercați din nou."

msgid "Zadajte platný e-mail."
msgstr "Introduceți un e-mail valid."

msgid "Predmet musí mať 3 až 150 znakov."
msgstr "Subiectul trebuie să aibă între 3 și 150 de caractere."

msgid "Text správy musí mať 20 až 4000 znakov."
msgstr "Textul mesajului trebuie să aibă între 20 și 4000 de caractere."

msgid "Počkajte prosím 30 sekúnd a skúste to znova."
msgstr "Așteptați 30 de secunde și încercați din nou."

msgid "Dosiahli ste limit 3 žiadostí za 10 minút. Skúste to neskôr."
msgstr "Ați atins limita de 3 cereri pe 10 minute. Încercați mai târziu."

msgid "Denný limit žiadostí bol dosiahnutý. Skúste to zajtra."
msgstr "Limita zilnică de cereri a fost atinsă. Încercați mâine."

msgid "Žiadosť sa nepodarilo odoslať z tohto WordPress webu. Skontrolujte SMTP/mail konfiguráciu hostingu."
msgstr "Cererea nu a putut fi trimisă de pe acest site WordPress. Verificați configurația SMTP/mail a găzduirii."

msgid "Detail chyby: %s"
msgstr "Detaliu eroare: %s"

msgid "Žiadosť bola úspešne odoslaná."
msgstr "Cererea a fost trimisă cu succes."

msgid "Cookie settings"
msgstr "Setări cookie-uri"

msgid "Súhlas nebol udelený."
msgstr "Consimțământul nu a fost acordat."

msgid "Žiadne cookies nie sú deklarované."
msgstr "Nu există cookie-uri declarate."
