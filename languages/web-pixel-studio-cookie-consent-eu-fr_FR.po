msgstr "Les paramètres ont été importés."

msgid "Import zlyhal. Skontrolujte súbor."
msgstr "L'importation a échoué. Vérifiez le fichier."

msgid "Vzhľad"
msgstr "Apparence"

msgid "Preklady"
msgstr "Traductions"

