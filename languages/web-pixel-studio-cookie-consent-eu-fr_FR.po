msgid "Web Pixel Studio Cookie Consent for EU"
msgstr "Web Pixel Studio Cookie Consent for EU"

msgid "GDPR & ePrivacy compliant cookie consent manager with Consent Mode v2 support, full customization, consent logging, and cookie blocking."
msgstr "Gestionnaire de consentement aux cookies conforme au RGPD et à l'ePrivacy avec prise en charge du Consent Mode v2, personnalisation complète, journalisation des consentements et blocage des cookies."

msgid "Web Pixel Studio"
msgstr "Web Pixel Studio"

msgid "https://webpixelstudio.org"
msgstr "https://webpixelstudio.org"

